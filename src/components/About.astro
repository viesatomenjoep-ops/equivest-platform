---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import exclusivityLeapImg from '../assets/images/exclusivity-in-every-leap.webp';
import Team from './Team.astro';
---

<section id="about" class="pt-8 pb-12 md:pt-12 md:pb-24 bg-white relative overflow-hidden scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="space-y-8">
        <div class="inline-block px-4 py-1.5 bg-bg-subtle border-l-4 border-accent">
          <span class="text-xl font-bold uppercase tracking-widest text-primary/90">Legacy of Excellence</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-serif text-primary leading-tight">
          {t('about.title')}
        </h2>
        <div class="space-y-6 text-xl text-primary/80 leading-relaxed font-medium">
          <p>
            {t('about.content')}
          </p>
          <p>
            {t('about.pitch1')}
          </p>
          <p>
            {t('about.pitch2')}
          </p>
          <div class="flex flex-col sm:flex-row sm:flex-wrap gap-8 pt-8 border-t border-gray-100">
             <div class="flex-1 min-w-[200px]">
                <span class="block text-4xl font-serif text-accent">30+</span>
                <span class="text-lg uppercase tracking-[0.2em] font-bold text-primary/90">Years of Experience</span>
             </div>
             <div class="flex-1 min-w-[200px]">
                <span class="block text-4xl font-serif text-accent">5-Star</span>
                <span class="text-lg uppercase tracking-[0.2em] font-bold text-primary/90">Grand Prix Pedigree</span>
             </div>
             <div class="flex-1 min-w-[200px]">
                <span class="block text-4xl font-serif text-accent">NL | DE | BE</span>
                <span class="text-lg uppercase tracking-[0.2em] font-bold text-primary/90">Key Markets</span>
             </div>
          </div>
        </div>
      </div>
      
      <div class="relative group">
        <div class="absolute inset-0 bg-accent translate-x-4 translate-y-4 -z-10 group-hover:translate-x-6 group-hover:translate-y-6 transition-transform duration-700"></div>
        <div class="aspect-[4/5] bg-gray-200 overflow-hidden shadow-premium">
           <Image 
            src={exclusivityLeapImg} 
            alt="Elite Showjumper" 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
           />
        </div>
        <div class="absolute bottom-12 -left-8 bg-primary-light p-8 shadow-premium max-w-[240px] transform transition-transform group-hover:-translate-y-2">
           <p class="text-white text-xl font-serif italic mb-2">"Exclusivity in Every Leap."</p>
           <div class="w-12 h-0.5 bg-accent-light"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Internal Team Section mapped to follow About context -->
  <div class="mt-8">
    <Team />
  </div>
  
  <!-- Subtle Background Element -->
  <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-96 h-96 bg-accent/5 rounded-full -z-10"></div>
  
  <!-- Interactive Subtle Scroll to Top Logo -->
  <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="absolute bottom-12 right-12 z-50 w-16 h-16 opacity-[0.06] hover:opacity-100 transition-all duration-700 cursor-pointer focus:outline-none hidden md:block">
    <img src="/images/logo.webp" alt="Scroll to top" width="64" height="64" loading="lazy" class="w-full h-full object-contain animate-slow-spin" />
  </button>
</section>
