---
import { languages } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Image } from "astro:assets";
import logoImg from "../../public/images/logo.webp";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { href: `/${lang}/#about`, label: t("nav.about") },
  { href: `/${lang}/#portfolio`, label: t("nav.portfolio") },
  { href: `/${lang}/#references`, label: t("nav.references") },
  { href: `/${lang}/#roi`, label: t("nav.roi") },
  { href: `/${lang}/#contact`, label: t("nav.contact") },
];
---

<header class="glass-header border-b border-gray-100 fixed w-full top-0 left-0 z-[1000]">
  <div class="max-width-site px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-24 relative w-full">
      <!-- MOBILE: Left Logo + Text (Hidden on xl desktop) -->
      <div class="flex items-center space-x-4 z-[110] xl:hidden">
        <a href={`/${lang}/`} class="group relative block">
          <div class="logo-spinner origin-center flex items-center justify-center">
            <Image
              src={logoImg}
              alt="Equivest Logo"
              width={256}
              class="w-14 h-14 object-contain transition-transform duration-500 group-hover:scale-110"
            />
          </div>
        </a>
        <a href={`/${lang}/`} class="flex flex-col text-left justify-center shrink-0">
          <span class="text-2xl font-serif font-bold tracking-tight text-primary uppercase leading-none">Equivest</span>
          <span class="text-[10px] font-bold tracking-[0.3em] text-primary/90 uppercase mt-1 self-end">Since 1995</span>
        </a>
      </div>

      <!-- DESKTOP LEFT: Brand Text (Hidden on mobile & tablet) -->
      <a href={`/${lang}/`} class="hidden xl:flex flex-col text-left justify-center shrink-0 z-[110]">
        <span class="text-2xl font-serif font-bold tracking-tight text-primary uppercase leading-none">Equivest</span>
        <span class="text-[10px] font-bold tracking-[0.3em] text-primary/90 uppercase mt-1 self-end">Since 1995</span>
      </a>

      <!-- DESKTOP CENTER: Navigation -->
      <div class="hidden xl:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center justify-center z-[110]">
        <nav class="flex items-center space-x-5 relative" id="desktop-nav-container">
          <div id="nav-indicator" class="absolute -bottom-2 left-0 h-[3px] bg-primary transition-all duration-300 ease-in-out opacity-0 pointer-events-none drop-shadow-md"></div>
          {
            navItems.map((item) => (
              <a href={item.href} data-astro-prefetch="hover" class="desktop-nav-item text-base font-bold tracking-widest hover:text-accent transition-colors uppercase whitespace-nowrap">
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- RIGHT: Utilities & Logo -->
      <div class="flex items-center space-x-4 ml-auto z-[110]">
        <!-- Desktop/Tablet Language Switcher -->
        <div class="hidden xl:flex items-center space-x-4">
          <div class="flex items-center xl:border-r border-gray-100 xl:pr-4 space-x-1">
            {
              Object.entries(languages).map(([l, _]) => (
                <a
                  href={`/${l}/`}
                  class={`text-lg font-bold uppercase tracking-tighter w-8 h-8 flex items-center justify-center rounded-full transition-all ${lang === l ? "bg-primary text-white" : "text-primary/70 hover:text-accent hover:bg-bg-subtle"}`}
                >
                  {l}
                </a>
              ))
            }
          </div>
        </div>

        <!-- Mobile & Tablet menu button -->
        <div class="xl:hidden flex items-center relative">
          <button id="menu-btn" class="text-primary hover:text-accent p-2 transition-colors focus:outline-none" aria-label="Toggle menu">
            <svg id="menu-icon" class="w-8 h-8 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path class="menu-path-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
              <path class="menu-path-close hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <!-- DESKTOP RIGHT: Logo (Hidden on mobile & tablet) -->
        <a href={`/${lang}/`} class="hidden xl:block group relative block z-[110]">
          <div class="logo-spinner origin-center flex items-center justify-center">
            <Image src={logoImg} alt="Equivest Logo" width={256} class="w-14 h-14 object-contain transition-transform duration-500 group-hover:scale-110" />
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-white z-[100] translate-x-full transition-transform duration-500 ease-in-out xl:hidden flex flex-col pt-32 px-8 pb-32 overflow-y-auto h-screen w-full"
  >
    <!-- Mobile Nav Links -->
    <nav class="flex flex-col space-y-3">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-item text-[22px] font-serif font-bold text-primary hover:text-accent transition-colors flex justify-between items-center group"
          >
            {item.label}
            <svg
              class="w-5 h-5 opacity-0 -translate-x-4 transition-all group-hover:opacity-100 group-hover:translate-x-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        ))
      }
    </nav>

    <!-- Mobile Language Selection -->
    <div class="mt-12 pb-10 pt-10 border-t border-gray-100">
      <p
        class="text-lg font-bold uppercase tracking-[0.2em] text-primary/70 mb-6"
      >
        Select Language
      </p>
      <div class="grid grid-cols-2 gap-3">
        {
          Object.entries(languages).map(([l, name]) => (
            <a
              href={`/${l}/`}
              class={`flex flex-col items-center justify-center p-4 rounded-xl border transition-all ${lang === l ? "border-accent bg-accent/5 text-primary" : "border-gray-100 text-primary/90 hover:border-accent/40"}`}
            >
              <span class="text-lg font-bold uppercase mb-1">{l}</span>
              <span class="text-lg opacity-90 font-medium">{name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<style>
  .glass-header {
    background: rgba(230, 230, 230, 0.98);
  }

  .max-width-site {
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Prevent body scroll when menu is open */
  :global(body.menu-open) {
    overflow: hidden;
    position: fixed;
    width: 100%;
  }
</style>

<script>
  function initMenu() {
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const openIcon = document.querySelector(".menu-path-open");
    const closeIcon = document.querySelector(".menu-path-close");

    if (!menuBtn || !mobileMenu) return;

    const toggleMenu = (show: boolean) => {
      if (show) {
        mobileMenu.classList.remove("translate-x-full");
        mobileMenu.classList.add("translate-x-0");
        openIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        document.body.classList.add("menu-open");
      } else {
        mobileMenu.classList.add("translate-x-full");
        mobileMenu.classList.remove("translate-x-0");
        openIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.classList.remove("menu-open");
      }
    };

    const isMenuOpen = () => mobileMenu.classList.contains("translate-x-0");

    const handleMenuClick = (e: Event) => {
      e.preventDefault();
      toggleMenu(!isMenuOpen());
    };

    menuBtn?.addEventListener("click", handleMenuClick);
    menuBtn?.addEventListener("touchstart", handleMenuClick, { passive: false });
    
    // Auto-close on click link
    document.querySelectorAll(".mobile-nav-item").forEach((item) => {
      item.addEventListener("click", () => toggleMenu(false));
    });

    // Close on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") toggleMenu(false);
    });
  }

  function initScrollRotate() {
    const spinners = document.querySelectorAll(".logo-spinner");
    if (!spinners.length) return;

    let scrollFrame: any;
    const handleScroll = () => {
      if (scrollFrame) cancelAnimationFrame(scrollFrame);
      scrollFrame = requestAnimationFrame(() => {
        const rotation = window.scrollY * 0.2;
        spinners.forEach((spinner: any) => {
          spinner.style.transform = `rotate(${rotation}deg)`;
        });
      });
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
  }

  function initScrollSpy() {
    const navItems = document.querySelectorAll('.desktop-nav-item');
    const indicator = document.getElementById('nav-indicator');
    if (!indicator || !navItems.length) return;

    const updateIndicator = (item: any) => {
      if (!item) {
        indicator.style.opacity = '0';
        return;
      }
      indicator.style.opacity = '1';
      indicator.style.left = `${item.offsetLeft}px`;
      indicator.style.width = `${item.offsetWidth}px`;
    };

    // simplified check for current URL path
    const currentPath = window.location.pathname.replace(/\/$/, ""); 
    const subpageMatch = Array.from(navItems).find(item => {
      const url = new URL((item as HTMLAnchorElement).href, window.location.origin);
      const isHome = url.pathname === '/' || /^\/[a-z]{2}\/?$/.test(url.pathname);
      return !isHome && url.pathname.replace(/\/$/, "") === currentPath;
    });

    if (subpageMatch) {
       setTimeout(() => updateIndicator(subpageMatch), 100);
       return; 
    }
  }

  // Load on initial navigation
  initMenu();
  initScrollRotate();
  initScrollSpy();

  // Load on View Transitions swap
  document.addEventListener("astro:after-swap", () => {
    initMenu();
    initScrollRotate();
    initScrollSpy();
  });
</script>
