---
import { languages } from '../i18n/ui';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { href: `/${lang}/#about`, label: t('nav.about') },
  { href: `/${lang}/#portfolio`, label: t('nav.portfolio') },
  { href: `/${lang}/#roi`, label: t('nav.roi') },
  { href: `/${lang}/#contact`, label: t('nav.contact') },
];
---

<header class="glass-header border-b border-gray-100">
  <div class="max-width-site px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-24">
      <!-- Logo -->
      <a href={`/${lang}/`} class="flex items-center space-x-3 group relative z-50">
        <img 
          src="/images/logo.png" 
          alt="Equivest Logo" 
          class="w-16 h-16 object-contain transition-transform duration-500 group-hover:scale-110"
        />
        <div class="flex flex-col">
          <span class="text-2xl font-serif font-bold tracking-tight text-primary uppercase leading-none">Equivest</span>
          <span class="text-[8px] font-bold tracking-[0.3em] text-accent uppercase mt-1 hidden sm:block">Elite Investments</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-8">
        {navItems.map(item => (
          <a href={item.href} class="text-xs font-bold tracking-widest hover:text-accent transition-colors uppercase">
            {item.label}
          </a>
        ))}
        
        <!-- Search Bar -->
        <div class="relative group ml-4">
          <input 
            type="text" 
            placeholder={t('nav.search') || 'Search...'} 
            class="bg-bg-subtle border border-transparent rounded-full py-2 px-5 text-[10px] focus:ring-1 focus:ring-accent focus:bg-white transition-all w-48 outline-none placeholder:text-primary/40"
          />
          <svg class="w-3.5 h-3.5 absolute right-4 top-2.5 text-primary/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Language Switcher -->
        <div class="flex items-center border-l border-gray-100 ml-6 pl-6 space-x-2">
          {Object.entries(languages).map(([l, _]) => (
            <a 
              href={`/${l}/`} 
              class={`text-[10px] font-bold uppercase tracking-tighter w-8 h-8 flex items-center justify-center rounded-full transition-all ${lang === l ? 'bg-primary text-accent' : 'text-primary/40 hover:text-accent hover:bg-bg-subtle'}`}
            >
              {l}
            </a>
          ))}
        </div>
      </nav>
      
      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center relative z-50">
         <button id="menu-btn" class="text-primary hover:text-accent p-2 transition-colors focus:outline-none" aria-label="Toggle menu">
            <svg id="menu-icon" class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path class="menu-path-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
               <path class="menu-path-close hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
         </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-white z-40 translate-x-full transition-transform duration-500 ease-in-out md:hidden flex flex-col pt-32 px-8 overflow-y-auto">
    <!-- Mobile Search -->
    <div class="relative mb-10">
      <input 
        type="text" 
        placeholder={t('nav.search') || 'Search showjumpers...'} 
        class="w-full bg-bg-subtle border-none rounded-xl py-4 px-6 text-sm focus:ring-2 focus:ring-accent outline-none"
      />
      <svg class="w-5 h-5 absolute right-5 top-4 text-primary/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <!-- Mobile Nav Links -->
    <nav class="flex flex-col space-y-6">
      {navItems.map(item => (
        <a href={item.href} class="text-2xl font-serif font-bold text-primary hover:text-accent transition-colors flex justify-between items-center group">
          {item.label}
          <svg class="w-5 h-5 opacity-0 -translate-x-4 transition-all group-hover:opacity-100 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </nav>

    <!-- Mobile Language Selection -->
    <div class="mt-auto pb-12 pt-12 border-t border-gray-100">
      <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary/40 mb-6">Select Language</p>
      <div class="grid grid-cols-2 gap-4">
        {Object.entries(languages).map(([l, name]) => (
          <a 
            href={`/${l}/`} 
            class={`flex flex-col items-center justify-center p-4 rounded-xl border transition-all ${lang === l ? 'border-accent bg-accent/5 text-primary' : 'border-gray-100 text-primary/60 hover:border-accent/40'}`}
          >
            <span class="text-sm font-bold uppercase mb-1">{l}</span>
            <span class="text-[10px] opacity-60 font-medium">{name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  .glass-header {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
  }

  .max-width-site {
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Prevent body scroll when menu is open */
  :global(body.menu-open) {
    overflow: hidden;
  }
</style>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.querySelector('.menu-path-open');
  const closeIcon = document.querySelector('.menu-path-close');

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('translate-x-0');
    
    if (isOpen) {
      mobileMenu?.classList.add('translate-x-full');
      mobileMenu?.classList.remove('translate-x-0');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.classList.remove('menu-open');
    } else {
      mobileMenu?.classList.remove('translate-x-full');
      mobileMenu?.classList.add('translate-x-0');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.classList.add('menu-open');
    }
  });

  // Close menu on link click
  const navLinks = mobileMenu?.querySelectorAll('a');
  navLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('translate-x-full');
      mobileMenu?.classList.remove('translate-x-0');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.classList.remove('menu-open');
    });
  });
</script>
