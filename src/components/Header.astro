---
import { languages } from '../i18n/ui';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { href: `/${lang}/#about`, label: t('nav.about') },
  { href: `/${lang}/#portfolio`, label: t('nav.portfolio') },
  { href: `/${lang}/#roi`, label: t('nav.roi') },
  { href: `/${lang}/#contact`, label: t('nav.contact') },
];
---

<header class="glass-header border-b border-gray-100">
  <div class="max-width-site px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Left: Brand (Logo + Text) -->
      <a href={`/${lang}/`} class="flex items-center space-x-3 group relative z-[110]">
        <img 
          src="/images/logo.png" 
          alt="Equivest Logo" 
          class="w-14 h-14 object-contain transition-transform duration-500 group-hover:scale-110"
        />
        <div class="flex flex-col">
          <span class="text-xl font-serif font-bold tracking-tight text-primary uppercase leading-none">Equivest</span>
          <span class="text-[7px] font-bold tracking-[0.3em] text-accent uppercase mt-0.5 hidden sm:block">Elite Investments</span>
        </div>
      </a>

      <!-- Right: Navigation & Utilities -->
      <div class="flex items-center gap-6">
        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-8">
          {navItems.map(item => (
            <a href={item.href} class="text-[10px] font-bold tracking-[0.15em] hover:text-accent transition-colors uppercase text-primary/70 hover:text-accent">
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Search & Language (Desktop) -->
        <div class="hidden lg:flex items-center gap-3 border-l border-gray-200 pl-6">
          <!-- Search Bar -->
          <div class="relative group">
            <input 
              type="text" 
              placeholder={t('nav.search') || 'Search...'} 
              class="bg-gray-50 border border-gray-100 rounded-full py-2 px-4 text-[10px] focus:ring-1 focus:ring-accent focus:bg-white focus:border-accent/30 transition-all w-36 outline-none placeholder:text-primary/30"
            />
            <svg class="w-3 h-3 absolute right-3 top-2.5 text-primary/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <!-- Language Switcher -->
          <div class="flex items-center gap-1 ml-1">
            {Object.entries(languages).map(([l, _]) => (
              <a 
                href={`/${l}/`} 
                class={`text-[10px] font-bold uppercase tracking-tighter w-7 h-7 flex items-center justify-center rounded-full transition-all ${lang === l ? 'bg-primary text-accent' : 'text-primary/30 hover:text-accent hover:bg-gray-50'}`}
              >
                {l}
              </a>
            ))}
          </div>
        </div>

        <!-- Mobile menu button -->
        <div class="lg:hidden flex items-center relative z-[110]">
           <button id="menu-btn" class="text-primary hover:text-accent p-2 transition-colors focus:outline-none" aria-label="Toggle menu">
              <svg id="menu-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                 <path class="menu-path-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8h16M4 16h16" />
                 <path class="menu-path-close hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
              </svg>
           </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-white z-[100] translate-x-full transition-transform duration-500 ease-in-out lg:hidden flex flex-col pt-28 px-8 pb-32 overflow-y-auto h-screen w-full">
    <!-- Mobile Search -->
    <div class="relative mb-8">
      <input 
        type="text" 
        placeholder={t('nav.search') || 'Search showjumpers...'} 
        class="w-full bg-gray-50 border border-gray-100 rounded-2xl py-4 px-6 text-sm focus:ring-2 focus:ring-accent outline-none"
      />
      <svg class="w-5 h-5 absolute right-5 top-4 text-primary/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <!-- Mobile Nav Links -->
    <nav class="flex flex-col space-y-6">
      {navItems.map(item => (
        <a href={item.href} class="text-2xl font-serif font-bold text-primary hover:text-accent transition-colors flex justify-between items-center group">
          {item.label}
          <svg class="w-5 h-5 text-primary/20 group-hover:text-accent group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </nav>

    <!-- Mobile Language Selection -->
    <div class="mt-auto pb-6 pt-8 border-t border-gray-100">
      <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary/30 mb-4">Select Language</p>
      <div class="grid grid-cols-4 gap-3">
        {Object.entries(languages).map(([l, name]) => (
          <a 
            href={`/${l}/`} 
            class={`flex flex-col items-center justify-center p-3 rounded-xl border transition-all ${lang === l ? 'border-accent bg-accent/5 text-primary' : 'border-gray-100 text-primary/50 hover:border-accent/40'}`}
          >
            <span class="text-sm font-bold uppercase">{l}</span>
            <span class="text-[9px] opacity-50 font-medium">{name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  .glass-header {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .max-width-site {
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Prevent body scroll when menu is open */
  :global(body.menu-open) {
    overflow: hidden;
    position: fixed;
    width: 100%;
  }
</style>

<script>
  function initMenu() {
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const openIcon = document.querySelector('.menu-path-open');
    const closeIcon = document.querySelector('.menu-path-close');

    if (!menuBtn || !mobileMenu) return;

    const toggleMenu = (show: boolean) => {
      if (show) {
        mobileMenu.classList.remove('translate-x-full');
        mobileMenu.classList.add('translate-x-0');
        openIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        document.body.classList.add('menu-open');
      } else {
        mobileMenu.classList.add('translate-x-full');
        mobileMenu.classList.remove('translate-x-0');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        document.body.classList.remove('menu-open');
      }
    };

    menuBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('translate-x-0');
      toggleMenu(!isOpen);
    });

    // Close menu on link click
    const navLinks = mobileMenu.querySelectorAll('a');
    navLinks.forEach(link => {
      link.addEventListener('click', () => toggleMenu(false));
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggleMenu(false);
    });
  }

  // Load on initial navigation
  initMenu();

  // Load on View Transitions swap (if enabled later)
  document.addEventListener('astro:after-swap', initMenu);
</script>
