---
import { getHorses } from '../lib/supabase';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';
import { getInstagramPosts } from '../lib/supabase';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const supabasePosts = await getInstagramPosts();
const igs = supabasePosts.map(post => post.post_id);
const latestPostId = igs.length > 0 ? igs[0] : null;
const archivePostIds = igs.slice(1);

const allHorsesRaw = await getHorses(lang);
const allHorses = allHorsesRaw.map(horse => ({
  id: horse.lang + '/' + horse.slug + '.md',
  data: {
    ...horse,
    specs: horse.specs || {},
    documents: horse.documents || {},
    gallery: horse.gallery || []
  },
  body: horse.body || ''
}));
const soldHorses = allHorses.filter(h => h.data.sold).sort((a, b) => (b.data.featured ? 1 : -1));
---

  <section id="references" class="pt-8 pb-12 md:pt-12 md:pb-24 bg-white relative overflow-hidden border-t-4 border-gray-100 scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-16 space-y-4 max-w-2xl mx-auto">
        <span class="text-primary/70 text-xl font-bold uppercase tracking-[0.3em] block">Past Successes</span>
        <h2 class="text-4xl md:text-5xl font-serif text-primary leading-tight">
          Recent Results & References
        </h2>
        <p class="text-primary/90 text-xl font-medium leading-relaxed">
           A record of absolute excellence. These elite athletes have been successfully placed with international riders and syndicated networks.
        </p>
      </div>

      {latestPostId && (
        <div class="mb-16 reveal reveal-up max-w-4xl mx-auto">
           <div class="flex items-center justify-between mb-6">
              <h3 class="text-3xl font-serif text-primary">Latest Post</h3>
           </div>
           <div class="group relative bg-white shadow-2xl ring-1 ring-primary/5 rounded-3xl overflow-hidden transition-all duration-700 hover:-translate-y-2">
             <div class="p-2 bg-gradient-to-b from-gray-50 to-white">
               <iframe 
                 src={`https://www.instagram.com/p/${latestPostId}/embed/captioned`} 
                 width="100%" 
                 frameborder="0" 
                 scrolling="no" 
                 allowtransparency="true" 
                 class="w-full h-[880px] bg-white rounded-2xl">
               </iframe>
             </div>
           </div>
        </div>
      )}

      <!-- Instagram Archive Grid -->
      {archivePostIds.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-10 md:mb-24">
          {archivePostIds.map((id, index) => (
            <div class={`group relative bg-white shadow-xl hover:shadow-2xl ring-1 ring-primary/5 rounded-2xl overflow-hidden transition-all duration-700 reveal reveal-up transform hover:-translate-y-2`} style={`transition-delay: ${index * 150}ms`}>
               <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-accent/0 via-accent to-accent/0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-10"></div>
               <div class="p-1 bg-gradient-to-b from-gray-50 to-white h-full pt-6">
                 <iframe 
                   src={`https://www.instagram.com/p/${id}/embed/captioned`} 
                   width="100%" 
                   frameborder="0" 
                   scrolling="no" 
                   allowtransparency="true" 
                   class="w-full h-[820px] bg-white rounded-xl">
                 </iframe>
               </div>
            </div>
          ))}
        </div>
      )}

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10 opacity-80 hover:opacity-100 transition-opacity duration-700">
        {soldHorses.map((horse, index) => (
          <div class="horse-card reveal reveal-scale bg-gray-50 group overflow-hidden shadow-sm border border-gray-100 flex flex-col h-full grayscale-[30%] hover:grayscale-0 transition-all relative" style={`transition-duration: 1200ms; transition-delay: ${index * 150}ms`}>
            <div class="aspect-[16/10] overflow-hidden relative">
              {typeof horse.data.image === 'string' ? (
                <img 
                  src={horse.data.image} 
                  alt={horse.data.title} 
                  onerror="this.onerror=null; this.src='/images/logo.png'; this.style.objectFit='contain'; this.style.padding='3rem'; this.style.opacity='0.2';"
                  class="w-full h-full object-cover"
                />
              ) : (
                <Image 
                  src={horse.data.image} 
                  alt={horse.data.title} 
                  class="w-full h-full object-cover"
                />
              )}
              
              <div class="absolute inset-0 bg-primary/40 flex items-center justify-center">
                 <div class="border-2 border-accent-light text-accent-light px-8 py-3 bg-primary/90 text-lg font-bold uppercase tracking-[0.4em] transform -rotate-12 shadow-2xl">
                    Sold
                 </div>
              </div>
            </div>
            
            <div class="p-8 flex-grow flex flex-col">
              <div class="flex items-center space-x-3 mb-3">
                <img src="/images/logo.webp" alt="Equivest" loading="lazy" width="64" height="64" class="w-16 h-16 object-contain brightness-0 animate-slow-spin" />
                <h3 class="text-2xl font-serif text-primary">{horse.data.title}</h3>
              </div>
              <p class="text-primary/80 text-lg font-medium line-clamp-2">
                {horse.data.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
