---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';

import stories from '../data/stories.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const horses = await getCollection('portfolio');
const soldHorses = horses.filter(h => h.data.sold).sort((a, b) => (b.data.featured ? 1 : -1));
---

  <section id="references" class="pt-8 pb-12 md:pt-12 md:pb-24 bg-white relative overflow-hidden border-t-4 border-gray-100 scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-16 space-y-4 max-w-2xl mx-auto">
        <span class="text-primary/70 text-xl font-bold uppercase tracking-[0.3em] block">Past Successes</span>
        <h2 class="text-4xl md:text-5xl font-serif text-primary leading-tight">
          Recent Results & References
        </h2>
        <p class="text-primary/90 text-xl font-medium leading-relaxed">
           A record of absolute excellence. These elite athletes have been successfully placed with international riders and syndicated networks.
        </p>
      </div>

      <!-- Equivest Stories Highlights Grid -->
      {stories && stories.length > 0 && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-10 md:mb-24">
            {stories.map((story, index) => (
              <div class={`group relative bg-black shadow-xl hover:shadow-2xl ring-1 ring-primary/5 rounded-2xl overflow-hidden transition-all duration-700 reveal reveal-up transform hover:-translate-y-2 cursor-pointer aspect-[9/16]`} style={`transition-delay: ${index * 150}ms`}>
                 <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10 pointer-events-none"></div>
                 <video 
                     src={typeof story === 'string' ? story : story.url} 
                     class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-500 scale-[1.01]"
                     autoplay 
                     loop 
                     muted 
                     playsinline 
                     preload="metadata">
                 </video>
                 <div class="absolute top-4 left-4 z-20 flex items-center space-x-2 bg-black/40 backdrop-blur-sm px-3 py-1.5 rounded-full">
                    <img src="/images/logo.png" alt="Equivest" class="w-5 h-5 object-contain brightness-0 invert" onerror="this.src='/images/logo.webp'" />
                    <span class="text-white text-xs font-bold tracking-widest uppercase">Equivest</span>
                 </div>
                 <div class="absolute bottom-4 left-0 w-full px-4 z-20 flex justify-between items-end">
                    <div class="flex items-center text-white/90">
                        <svg class="w-5 h-5 mr-1 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span class="text-xs font-bold uppercase tracking-wider">Play</span>
                    </div>
                 </div>
              </div>
            ))}
          </div>
      )}

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10 opacity-80 hover:opacity-100 transition-opacity duration-700">
        {soldHorses.map((horse, index) => (
          <div class="horse-card reveal reveal-scale bg-gray-50 group overflow-hidden shadow-sm border border-gray-100 flex flex-col h-full grayscale-[30%] hover:grayscale-0 transition-all relative" style={`transition-duration: 1200ms; transition-delay: ${index * 150}ms`}>
            <div class="aspect-[16/10] overflow-hidden relative">
              {typeof horse.data.image === 'string' ? (
                <img 
                  src={horse.data.image} 
                  alt={horse.data.title} 
                  onerror="this.onerror=null; this.src='/images/logo.png'; this.style.objectFit='contain'; this.style.padding='3rem'; this.style.opacity='0.2';"
                  class="w-full h-full object-cover"
                />
              ) : (
                <Image 
                  src={horse.data.image} 
                  alt={horse.data.title} 
                  class="w-full h-full object-cover"
                />
              )}
              
              <div class="absolute inset-0 bg-primary/40 flex items-center justify-center">
                 <div class="border-2 border-accent-light text-accent-light px-8 py-3 bg-primary/90 text-lg font-bold uppercase tracking-[0.4em] transform -rotate-12 shadow-2xl">
                    Sold
                 </div>
              </div>
            </div>
            
            <div class="p-8 flex-grow flex flex-col">
              <div class="flex items-center space-x-3 mb-3">
                <img src="/images/logo.webp" alt="Equivest" loading="lazy" width="64" height="64" class="w-16 h-16 object-contain brightness-0 animate-slow-spin" />
                <h3 class="text-2xl font-serif text-primary">{horse.data.title}</h3>
              </div>
              <p class="text-primary/80 text-lg font-medium line-clamp-2">
                {horse.data.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
