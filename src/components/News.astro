---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';

import img1 from '../assets/images/hero.png';
import img2 from '../assets/images/perfect-picture.jpg';
import img3 from '../assets/images/Victoria.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// English is default baseline for the news data
const newsArticles = {
  en: [
    {
      date: 'April 2026',
      title: 'High-End Hunter & Jumper Market Sets New Records in the US',
      excerpt: 'The demand for top-tier Grand Prix jumpers and elite hunter prospects in America continues to surge, with prices reaching an all-time high well into the seven-figure range.',
      source: 'Industry Report',
      image: img1,
      url: '#'
    },
    {
      date: 'March 2026',
      title: 'The Rise of Leasing: A Dominant Trend in 2026',
      excerpt: 'Leasing has become the predominant strategy for US equestrians to manage costs and mitigate risks in the middle market, creating massive potential for syndicates and owners.',
      source: 'The Plaid Horse',
      image: img2,
      url: '#'
    },
    {
      date: 'February 2026',
      title: 'Global shifts: The value of European-Trained Prospects',
      excerpt: 'With domestic US prices soaring due to limited high-end supply, carefully selected European imports refined for the US market represent the highest ROI potential for investors.',
      source: 'Market Insight',
      image: img3,
      url: '#'
    }
  ],
  nl: [
    {
      date: 'April 2026',
      title: 'Topsegment Amerikaanse Hunter & Jumper markt breekt records',
      excerpt: 'De vraag naar Grand Prix springpaarden en elite hunter-paarden in de V.S. blijft stijgen, waarbij topprijzen inmiddels de grens van een miljoen ruim passeren.',
      source: 'Industry Report',
      image: img1,
      url: '#'
    },
    {
      date: 'Maart 2026',
      title: 'Leasen: Dé dominante trend voor de paardensport in 2026',
      excerpt: 'Leasen is momenteel de belangrijkste strategie in de V.S. om risico\'s te vermijden. Dit biedt een gigantisch potentieel voor syndicaten en investeerders.',
      source: 'The Plaid Horse',
      image: img2,
      url: '#'
    },
    {
      date: 'Februari 2026',
      title: 'Waarom de vraag naar in Europa getrainde beloftes piekt',
      excerpt: 'Nu de Amerikaanse prijzen door schaars aanbod omhoog schieten, vormen in Europa geselecteerde topatleten de absolute sweet-spot voor een hoog rendement.',
      source: 'Market Insight',
      image: img3,
      url: '#'
    }
  ],
  de: [
    {
      date: 'April 2026',
      title: 'US-Hunter- und Jumper-Markt im Spitzensegment bricht Rekorde',
      excerpt: 'Die Nachfrage nach erstklassigen Grand-Prix-Springpferden und Elite-Hunters in Amerika steigt weiter an, wobei die Preise siebenstellige Beträge erreichen.',
      source: 'Industry Report',
      image: img1,
      url: '#'
    },
    {
      date: 'März 2026',
      title: 'Leasing boomt: Der vorherrschende Trend im Jahr 2026',
      excerpt: 'Leasing ist zur wichtigsten Strategie im US-Reitsport geworden, um Kosten zu optimieren, was Investoren und Syndikaten gewaltiges Potenzial bietet.',
      source: 'The Plaid Horse',
      image: img2,
      url: '#'
    },
    {
      date: 'Februar 2026',
      title: 'Große Nachfrage nach in Europa ausgebildeten Talenten',
      excerpt: 'Angesichts steigender Inlands-Preise in den USA und eines begrenzten Top-Angebots stellen in Europa geförderte Talente die höchste ROI-Chance für Investoren dar.',
      source: 'Market Insight',
      image: img3,
      url: '#'
    }
  ],
  es: [
    {
      date: 'Abril 2026',
      title: 'El Mercado de Alta Gama en EE. UU. rompe nuevos récords',
      excerpt: 'La demanda de saltadores de Grand Prix y caballos Hunter de élite en Estados Unidos sigue aumentando, alcanzando precios insólitos de siete cifras.',
      source: 'Industry Report',
      image: img1,
      url: '#'
    },
    {
      date: 'Marzo 2026',
      title: 'El Arrendamiento: La Tendencia Dominante de 2026',
      excerpt: 'El leasing se ha convertido en la estrategia principal para gestionar los costes en EE. UU., creando enormes oportunidades de beneficio para los inversores.',
      source: 'The Plaid Horse',
      image: img2,
      url: '#'
    },
    {
      date: 'Febrero 2026',
      title: 'El alto valor de las jóvenes promesas entrenadas en Europa',
      excerpt: 'Con los precios nacionales de EE. UU. disparados por la falta de oferta de calidad, los caballos europeos seleccionados representan el mayor retorno de inversión.',
      source: 'Market Insight',
      image: img3,
      url: '#'
    }
  ]
};

const articles = newsArticles[lang] || newsArticles.en;
---

<section id="news" class="py-12 md:py-24 bg-bg-light relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-end mb-16">
      <div class="space-y-4">
        <h2 class="text-4xl md:text-5xl font-serif text-primary">{t('news.title')}</h2>
        <div class="w-16 h-1 bg-accent"></div>
      </div>
      <div class="hidden md:block">
        <span class="text-lg font-bold tracking-[0.3em] uppercase text-primary/70">US Market Intel</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {articles.map((article) => (
        <article class="bg-white group cursor-pointer border border-gray-100 hover:shadow-2xl transition-all duration-500 overflow-hidden rounded-xl flex flex-col h-full">
          <div class="relative h-56 overflow-hidden">
            <div class="absolute inset-0 bg-primary/20 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
            <Image 
              src={article.image} 
              alt={article.title}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-white/90 backdrop-blur text-primary px-3 py-1 text-lg font-bold uppercase tracking-widest rounded-full">
                {t('news.tag')}
              </span>
            </div>
          </div>
          
          <div class="p-8 flex flex-col flex-1">
            <div class="flex justify-between items-center mb-4">
              <span class="text-accent text-lg font-bold uppercase tracking-widest">{article.date}</span>
            </div>
            <h3 class="text-2xl font-serif text-primary mb-4 leading-snug group-hover:text-accent transition-colors">
              {article.title}
            </h3>
            <p class="text-lg font-medium text-primary/70 leading-relaxed mb-8 flex-1">
              {article.excerpt}
            </p>
            <div class="mt-auto border-t border-gray-100 pt-6 flex justify-between items-center">
              <span class="text-lg font-bold uppercase tracking-widest text-primary/70">{article.source}</span>
              <span class="text-lg font-bold uppercase tracking-[0.2em] text-accent flex items-center group-hover:translate-x-2 transition-transform">
                {t('news.read_more')}
                <svg class="w-3 h-3 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
