---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const whatsappNumber = "+115613010984"; // Normalized for link
const email = "equivestbv@gmail.com";
---

<section id="contact" class="pt-6 pb-8 md:pt-8 md:pb-10 bg-primary text-white relative overflow-hidden scroll-mt-24">
  <!-- Decorative background -->
  <div class="absolute inset-0 opacity-10">
     <div class="absolute top-0 left-0 w-full h-full bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <div class="space-y-2 md:space-y-4 max-w-3xl mx-auto mb-3 md:mb-4 md:mb-10">
      <span class="text-accent-light text-SM md:text-base font-bold uppercase tracking-[0.4em]">{t('contact.inquiry')}</span>
      <h2 class="text-2xl md:text-4xl font-serif leading-tight">
        {t('contact.connect_pre')}<span class="italic text-accent-light">{t('contact.connect_elite')}</span>{t('contact.connect_post')}
      </h2>
      <p class="text-white/90 text-base md:text-lg font-medium leading-relaxed">
        {t('contact.ready')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-6xl mx-auto mb-8">
      <!-- WhatsApp CTA -->
      <a 
        href={`https://wa.me/15613010984`} 
        target="_blank" 
        class="group flex flex-col items-center p-6 md:p-8 bg-white/5 border border-white/10 hover:border-accent-light hover:bg-white/10 transition-all duration-500 shadow-premium"
      >
        <div class="w-12 h-12 md:w-14 md:h-14 bg-accent-light/20 rounded-full flex items-center justify-center mb-3 md:mb-4 group-hover:scale-110 transition-transform">
           <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 text-accent-light" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
              <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
           </svg>
        </div>
        <span class="text-white text-lg md:text-xl font-serif mb-1">{t('contact.whatsapp')}</span>
        <span class="text-accent-light text-xs md:text-sm font-bold uppercase tracking-widest">+1 (561) 301-0984</span>
      </a>

      <!-- Email CTA -->
      <a 
        href={`mailto:${email}`} 
        class="group flex flex-col items-center p-6 md:p-8 bg-white/5 border border-white/10 hover:border-accent-light hover:bg-white/10 transition-all duration-500 shadow-premium"
      >
        <div class="w-12 h-12 md:w-14 md:h-14 bg-accent-light/20 rounded-full flex items-center justify-center mb-3 md:mb-4 group-hover:scale-110 transition-transform">
           <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 text-accent-light" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <polyline points="3 7 12 13 21 7" />
           </svg>
        </div>
        <span class="text-white text-lg md:text-xl font-serif mb-1">{t('contact.email')}</span>
        <span class="text-accent-light text-xs md:text-sm font-bold uppercase tracking-widest">{email}</span>
      </a>

      <!-- Instagram CTA -->
      <a 
        href={`https://www.instagram.com/nomoregrayarea36?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==`} 
        target="_blank"
        class="group flex flex-col items-center p-6 md:p-8 bg-white/5 border border-white/10 hover:border-accent-light hover:bg-white/10 transition-all duration-500 shadow-premium"
      >
        <div class="w-12 h-12 md:w-14 md:h-14 bg-accent-light/20 rounded-full flex items-center justify-center mb-3 md:mb-4 group-hover:scale-110 transition-transform">
           <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 md:w-6 md:h-6 text-accent-light" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <rect x="4" y="4" width="16" height="16" rx="4" />
              <circle cx="12" cy="12" r="3" />
              <line x1="16.5" y1="7.5" x2="16.5" y2="7.501" />
           </svg>
        </div>
        <span class="text-white text-lg md:text-xl font-serif mb-1">Instagram</span>
        <span class="text-accent-light text-xs md:text-sm font-bold uppercase tracking-widest">Follow Us</span>
      </a>
    </div>

    <!-- Location / Address -->
    <div class="max-w-6xl mx-auto reveal reveal-up delay-200">
      <div class="flex flex-col md:flex-row bg-white/5 border border-white/10 shadow-premium overflow-hidden group">
        <!-- Address Info -->
        <a href="https://maps.google.com/?q=Huikvenweg+8,+2990+Wuustwezel" target="_blank" rel="noopener noreferrer" class="md:w-1/3 p-6 md:p-8 text-left flex flex-col justify-center border-b md:border-b-0 md:border-r border-white/10 hover:bg-white/10 hover:shadow-[inset_0_0_60px_rgba(255,255,255,0.05)] transition-all duration-500 cursor-pointer group/location">
          <div class="w-12 h-12 bg-accent-light/20 rounded-full flex items-center justify-center mb-3 md:mb-4 group-hover/location:scale-110 group-hover/location:bg-accent-light/30 transition-all duration-500">
            <svg class="w-6 h-6 text-accent-light group-hover/location:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-serif text-white mb-2 underline-offset-4 group-hover/location:underline">Location</h3>
          <div class="space-y-1 text-white/90 font-medium leading-relaxed">
            <p class="text-white font-medium underline-offset-4 group-hover/location:underline">Huikvenweg 8</p>
            <p class="underline-offset-4 group-hover/location:underline">2990 Wuustwezel</p>
          </div>
          <div class="mt-4 pt-4 border-t border-white/10">
            <p class="text-accent-light text-sm md:text-base italic">{t('contact.apg')}</p>
          </div>
        </a>

        <!-- Google Maps -->
        <div class="md:w-2/3 h-48 md:h-full relative bg-[#e5e3df]">
          <iframe 
             src="https://maps.google.com/maps?q=Huikvenweg%208,%202990%20Wuustwezel&t=&z=14&ie=UTF8&iwloc=&output=embed" 
             width="100%" 
             height="100%" 
             style="border:0;" 
             allowfullscreen="" 
             loading="lazy" 
             referrerpolicy="no-referrer-when-downgrade"
             class="absolute inset-0 grayscale-[40%] contrast-[1.1] opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700"
          ></iframe>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-6 md:mt-12 md:pt-8 border-t border-white/5">
       <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <div class="flex items-center space-x-4">
             <img 
               src="/images/logo.webp" 
               alt="Equivest Logo" 
               loading="lazy"
               width="48"
               height="48"
               class="w-10 h-10 md:w-12 md:h-12 object-contain brightness-0 invert animate-[spin_15s_linear_infinite]" 
             />
             <div class="flex flex-col text-left">
               <span class="text-lg md:text-xl font-serif font-bold tracking-tight text-white uppercase leading-none">Equivest</span>
               <span class="text-xs md:text-sm font-bold tracking-[0.2em] text-accent-light uppercase mt-1">Elite Investments</span>
             </div>
          </div>
          <p class="text-white/60 text-xs md:text-sm uppercase tracking-widest text-center md:text-right">© 2026 Equivest Portfolio Management. All Rights Reserved.</p>
       </div>
    </div>
  </div>

  <!-- Interactive Subtle Scroll to Top Logo -->
  <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="absolute bottom-8 right-8 z-0 w-16 h-16 opacity-[0.03] hover:opacity-[0.10] transition-all duration-700 cursor-pointer focus:outline-none hidden sm:block">
    <img src="/images/logo.webp" alt={t('ui.scroll_top')} width="64" height="64" loading="lazy" class="w-full h-full object-contain brightness-0 invert" />
  </button>
</section>
