---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const whatsappNumber = "+115613010984"; // Normalized for link
const email = "equivestbv@gmail.com";
---

<section id="contact" class="py-12 md:py-24 bg-primary text-white relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute inset-0 opacity-10">
     <div class="absolute top-0 left-0 w-full h-full bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <div class="space-y-6 max-w-3xl mx-auto mb-16">
      <span class="text-accent text-xs font-bold uppercase tracking-[0.4em]">Investment Inquiry</span>
      <h2 class="text-4xl md:text-6xl font-serif leading-tight">
        Connect with our <span class="italic text-accent">Elite</span> network
      </h2>
      <p class="text-white/60 text-lg font-light leading-relaxed">
        Ready to explore high-end investment opportunities in the world of showjumping? Our team is available for private consultations and personalized investment plans.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- WhatsApp CTA -->
      <a 
        href={`https://wa.me/15613010984`} 
        target="_blank" 
        class="group flex flex-col items-center p-12 bg-white/5 border border-white/10 hover:border-accent hover:bg-white/10 transition-all duration-500 shadow-premium"
      >
        <div class="w-16 h-16 bg-accent/20 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
           <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-accent" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
              <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
           </svg>
        </div>
        <span class="text-white text-xl font-serif mb-2">{t('contact.whatsapp')}</span>
        <span class="text-accent text-[11px] font-bold uppercase tracking-widest">+1 (561) 301-0984</span>
      </a>

      <!-- Email CTA -->
      <a 
        href={`mailto:${email}`} 
        class="group flex flex-col items-center p-12 bg-white/5 border border-white/10 hover:border-accent hover:bg-white/10 transition-all duration-500 shadow-premium"
      >
        <div class="w-16 h-16 bg-accent/20 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
           <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-accent" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <polyline points="3 7 12 13 21 7" />
           </svg>
        </div>
        <span class="text-white text-xl font-serif mb-2">{t('contact.email')}</span>
        <span class="text-accent text-[11px] font-bold uppercase tracking-widest">{email}</span>
      </a>
    </div>

    <div class="mt-24 pt-8 border-t border-white/5">
       <div class="flex flex-col md:flex-row justify-between items-center gap-8">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 bg-accent flex items-center justify-center rounded-sm">
              <span class="text-primary font-serif font-bold text-sm">E</span>
            </div>
            <span class="text-lg font-serif font-bold tracking-tight text-white uppercase italic">Equivest</span>
          </div>
          <p class="text-white/30 text-[10px] uppercase tracking-widest">© 2026 Equivest Portfolio Management. All Rights Reserved.</p>
       </div>
    </div>
  </div>

  <!-- Interactive Subtle Scroll to Top Logo -->
  <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="absolute bottom-8 right-8 z-0 w-32 h-32 md:w-56 md:h-56 opacity-[0.03] hover:opacity-[0.10] transition-all duration-700 cursor-pointer focus:outline-none hidden sm:block">
    <img src="/images/logo.png" alt="Scroll to top" class="w-full h-full object-contain brightness-0 invert" />
  </button>
</section>
