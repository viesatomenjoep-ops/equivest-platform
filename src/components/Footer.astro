---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-primary text-white py-8 border-t border-white/5 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center space-x-4">
        <img 
          src="/images/logo.webp" 
          alt="Equivest Logo" 
          loading="lazy"
          width="48"
          height="48"
          class="w-10 h-10 md:w-12 md:h-12 object-contain brightness-0 invert animate-[spin_15s_linear_infinite]" 
        />
        <div class="flex flex-col text-left">
          <span class="text-lg md:text-xl font-serif font-bold tracking-tight text-white uppercase leading-none">Equivest</span>
          <span class="text-xs md:text-sm font-bold tracking-[0.2em] text-accent-light uppercase mt-1">Elite Investments</span>
        </div>
      </div>
      <p class="text-white/60 text-xs md:text-sm uppercase tracking-widest text-center md:text-right">© 2026 Equivest Portfolio Management. All Rights Reserved.</p>
    </div>
  </div>

  <!-- Interactive Subtle Scroll to Top Logo -->
  <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="absolute bottom-4 right-8 w-12 h-12 opacity-[0.05] hover:opacity-[0.10] transition-all duration-700 cursor-pointer focus:outline-none hidden sm:block">
    <img src="/images/logo.webp" alt="Scroll to top" width="64" height="64" loading="lazy" class="w-full h-full object-contain brightness-0 invert" />
  </button>
</footer>
