<div class="logo-container group flex items-center gap-4">
  <div class="logo-mandala transition-transform duration-700 group-hover:rotate-12">
    <svg width="64" height="64" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Outer Ring -->
      <circle cx="50" cy="50" r="45" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2" class="text-accent/30" />
      
      <!-- Ornate Petals (Simplified Mandala representation) -->
      <g class="text-accent">
        {[0, 45, 90, 135, 180, 225, 270, 315].map((angle) => (
          <path 
            d="M50 50 Q60 20 50 10 Q40 20 50 50" 
            transform={`rotate(${angle} 50 50)`} 
            fill="currentColor" 
            fill-opacity="0.15"
            stroke="currentColor" 
            stroke-width="1.5"
          />
        ))}
        
        <!-- Inner Flower -->
        <circle cx="50" cy="50" r="8" fill="currentColor" />
        <circle cx="50" cy="50" r="12" stroke="currentColor" stroke-width="1" fill="none" />
        
        <!-- Detail Lines -->
        <path d="M50 5 L50 95 M5 50 L95 50" stroke="currentColor" stroke-width="0.5" stroke-opacity="0.2" />
      </g>
    </svg>
  </div>
  <div class="flex flex-col">
    <span class="text-3xl font-serif font-bold tracking-[0.1em] text-primary uppercase leading-none">Equivest</span>
    <span class="text-[8px] font-bold tracking-[0.5em] text-accent uppercase mt-1">Elite Investments</span>
  </div>
</div>

<style>
  .logo-mandala {
    filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.2));
  }
</style>
