---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const horses = await getCollection('portfolio');
const featuredHorses = horses.filter(h => h.data.featured).slice(0, 3);
const allHorses = horses.sort((a, b) => (b.data.featured ? 1 : -1));
---

<section id="portfolio" class="py-12 md:py-24 bg-bg-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <div class="space-y-4 max-w-2xl">
        <span class="text-accent text-xs font-bold uppercase tracking-[0.3em] block">Our Collection</span>
        <h2 class="text-4xl md:text-5xl font-serif text-primary leading-tight">
          {t('portfolio.title')}
        </h2>
        <p class="text-primary/60 text-lg font-light leading-relaxed">
           Explore our selection of elite showjumpers from the finest breeding lines in Europe. Each horse is hand-picked for investment potential.
        </p>
      </div>
      <div class="flex flex-wrap gap-4 mt-6 md:mt-0">
         <button class="filter-btn active text-primary font-bold uppercase tracking-widest border-b border-primary pb-2 text-[10px] md:text-xs transition-colors" data-filter="all">All</button>
         <button class="filter-btn text-primary/40 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-[10px] md:text-xs transition-colors" data-filter="Grand Prix">Grand Prix</button>
         <button class="filter-btn text-primary/40 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-[10px] md:text-xs transition-colors" data-filter="Youngster">Youngster</button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10">
      {allHorses.map((horse) => (
        <div class="horse-card bg-white group overflow-hidden shadow-sm hover:shadow-premium transition-shadow duration-500 border border-gray-100 flex flex-col h-full" data-level={horse.data.specs?.level}>
          <div class="aspect-[16/10] overflow-hidden relative">
            <Image 
              src={horse.data.image} 
              alt={horse.data.title} 
              inferSize={true}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            {horse.data.featured && (
              <div class="absolute top-4 left-4 bg-primary text-accent text-[10px] font-bold uppercase tracking-widest px-3 py-1 shadow-xl">
                 Prime Selection
              </div>
            )}
            
            <!-- YouTube Overlay -->
            {horse.data.youtube_url && (
              <div class="absolute inset-0 bg-primary/20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                 <div class="w-12 h-12 bg-white flex items-center justify-center rounded-full text-primary scale-90 group-hover:scale-100 transition-transform">
                    <svg class="w-6 h-6 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                 </div>
              </div>
            )}
          </div>
          
          <div class="p-8 flex-grow flex flex-col">
            <h3 class="text-2xl font-serif text-primary mb-3 group-hover:text-accent transition-colors">{horse.data.title}</h3>
            <p class="text-primary/70 text-sm font-light mb-6 line-clamp-2">
              {horse.data.description}
            </p>
            
            <div class="mt-auto grid grid-cols-2 gap-y-4 border-t border-gray-50 pt-6">
              <div class="space-y-1">
                <span class="text-[9px] uppercase tracking-widest text-primary/40 font-bold block">Age</span>
                <span class="text-sm font-serif text-primary">{horse.data.specs?.age} Years</span>
              </div>
              <div class="space-y-1">
                <span class="text-[9px] uppercase tracking-widest text-primary/40 font-bold block">Level</span>
                <span class="text-sm font-serif text-primary">{horse.data.specs?.level}</span>
              </div>
              <div class="space-y-1">
                <span class="text-[9px] uppercase tracking-widest text-primary/40 font-bold block">Gender</span>
                <span class="text-sm font-serif text-primary">{horse.data.specs?.gender}</span>
              </div>
              <div class="space-y-1">
                <span class="text-[9px] uppercase tracking-widest text-primary/40 font-bold block">Height</span>
                <span class="text-sm font-serif text-primary">{horse.data.specs?.height}</span>
              </div>
            </div>
          </div>
          
          <div class="border-t border-gray-100 p-4">
             <a href={`/${lang}/contact`} class="block w-full text-center py-3 text-[11px] font-bold uppercase tracking-[0.2em] bg-bg-subtle hover:bg-primary hover:text-white transition-all text-primary/60">
                Inquire Details
             </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initGalleryFilters() {
    const filters = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.horse-card');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active states
        filters.forEach(f => {
          f.classList.remove('active', 'text-primary', 'border-primary');
          f.classList.add('text-primary/40', 'border-primary/10');
        });
        btn.classList.add('active', 'text-primary', 'border-primary');
        btn.classList.remove('text-primary/40', 'border-primary/10');

        const filterValue = btn.getAttribute('data-filter');

        cards.forEach(card => {
          if (filterValue === 'all') {
            (card as HTMLElement).style.display = 'flex';
          } else {
            const level = card.getAttribute('data-level') || '';
            // Simple string matching for now
            if (level.includes(filterValue!)) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          }
        });
      });
    });
  }

  initGalleryFilters();
  document.addEventListener('astro:after-swap', initGalleryFilters);
</script>
