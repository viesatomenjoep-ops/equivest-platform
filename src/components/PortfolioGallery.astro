---
import { getCollection, render } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const horses = await getCollection('portfolio');
const allHorses = horses
  .filter(h => !h.data.sold && h.id.startsWith(lang + '/'))
  .sort((a, b) => (b.data.premium ? 1 : -1));


const allHorsesWithContent = await Promise.all(
  allHorses.map(async (horse) => {
    const { Content } = await render(horse);
    return {
      id: horse.id,
      data: horse.data,
      category: horse.data.category || '',
      Content
    };
  })
);
---

<section id="portfolio" class="pt-8 pb-12 md:pt-12 md:pb-24 bg-bg-subtle relative overflow-hidden scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">


    <div id="portfolio-lock" class="absolute inset-0 z-[50] flex flex-col items-center justify-start bg-bg-subtle w-full transition-all duration-700 px-4 sm:px-0">
      <div class="max-w-md w-full space-y-6 md:space-y-8 text-center reveal reveal-up bg-white p-6 md:p-10 shadow-2xl border-x border-b border-t-0 border-gray-100">
        <img src="/images/logo.webp" alt="Equivest Access" loading="lazy" width="80" height="80" class="w-16 h-16 md:w-20 md:h-20 mx-auto object-contain brightness-0 animate-slow-spin" />
        <h2 class="text-3xl md:text-4xl font-serif text-primary">{t("portfolio.private_access")}</h2>
        <p class="text-primary/70 text-base md:text-lg">{t("portfolio.access_desc")}</p>
        
        <form id="portfolio-form" class="mt-8 space-y-4">
          <div>
            <input 
                type="text" 
                id="portfolio-user"
                required
                class="w-full bg-bg-subtle border border-primary/20 p-4 text-center tracking-[0.2em] font-bold text-primary focus:outline-none focus:border-accent transition-colors mb-4"
                placeholder={t("portfolio.username")}
              />
            <input 
              type="password" 
              id="portfolio-code"
              required
              class="w-full bg-bg-subtle border border-primary/20 p-4 text-center tracking-[0.2em] font-bold text-primary focus:outline-none focus:border-accent transition-colors"
              placeholder={t("portfolio.password")}
            />
            <p id="portfolio-error" class="text-red-500 mt-2 text-sm font-bold uppercase tracking-widest hidden">{t("portfolio.invalid")}</p>
          </div>
          <button type="submit" class="w-full bg-primary text-white font-bold uppercase tracking-[0.2em] py-4 hover:bg-accent transition-colors">
            {t("portfolio.unlock")}
          </button>
        </form>
        
        <p class="text-xs md:text-sm text-primary/70 mt-6">{t("portfolio.request_access")}</p>
      </div>
    </div>

    <!-- THE PORTFOLIO CONTENT (Blurred by default) -->
    <div id="portfolio-content" class="opacity-10 select-none pointer-events-none transition-all duration-1000 h-[500px] overflow-hidden">
      
      <div class="flex flex-wrap gap-4 mb-8">
         <button class="filter-btn active text-primary font-bold uppercase tracking-widest border-b border-primary pb-2 text-lg md:text-xl transition-colors" data-filter="all">{t("portfolio.filter_all")}</button>
         <button class="filter-btn text-primary/70 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-lg md:text-xl transition-colors" data-filter="Hunters">Hunters</button>
         <button class="filter-btn text-primary/70 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-lg md:text-xl transition-colors" data-filter="Jumpers">Jumpers</button>
         <button class="filter-btn text-primary/70 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-lg md:text-xl transition-colors" data-filter="Ponys">Pony's</button>
         <button class="filter-btn text-primary/70 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-lg md:text-xl transition-colors" data-filter="Equitation">Equitation</button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10">
        {allHorsesWithContent.map((horse, index) => (
          <div class="horse-card reveal reveal-scale bg-white group overflow-hidden shadow-sm hover:shadow-premium transition-shadow flex flex-col h-full cursor-pointer" onclick={`window.location.href='/${lang}/portfolio/${horse.id.replace('.md','').split('/').slice(1).join('/')}'`} style={`transition-delay: ${(index % 3) * 75}ms`} data-category={horse.category}>
            <div class="relative cursor-pointer overflow-hidden bg-gray-50/50 flex items-center justify-center" onclick={`window.location.href='/${lang}/portfolio/${horse.id.replace('.md','').split('/').slice(1).join('/')}'`}>
              {typeof horse.data.image === 'string' ? (
                <img 
                  src={horse.data.image} 
                  alt={horse.data.title} 
                  loading="lazy" 
                  decoding="async"
                  onerror="this.onerror=null; this.src='/images/logo.webp'; this.style.objectFit='contain'; this.style.padding='3rem'; this.style.opacity='0.2';"
                  class="w-full h-auto max-h-[350px] object-contain transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <Image 
                  src={horse.data.image} 
                  alt={horse.data.title} 
                  format="webp"
                  class="w-full h-auto max-h-[350px] object-contain transition-transform duration-700 group-hover:scale-105"
                />
              )}
        </div>
        
        <div class="p-5 md:p-6 flex-grow flex flex-col">
          <div class="flex items-center space-x-3 mb-3 cursor-pointer" onclick={`window.location.href='/${lang}/portfolio/${horse.id.replace('.md','').split('/').slice(1).join('/')}'`}>
            <img src="/images/logo.webp" alt="Equivest" loading="lazy" width="64" height="64" class="w-10 h-10 object-contain brightness-0" />
            <h3 class="text-xl font-serif text-primary group-hover:text-accent transition-colors">{horse.data.title}</h3>
          </div>
          <p class="text-primary/70 text-sm font-medium mb-4 line-clamp-2">
            {horse.data.description}
          </p>
          
          <div class="mt-auto grid grid-cols-2 gap-4 border-t border-gray-50 pt-4">
            <div class="space-y-1">
              <span class="text-[0.65rem] uppercase tracking-widest text-primary/70 font-bold block">{t('ui.age')}</span>
              <span class="text-sm font-serif text-primary">{horse.data.specs?.age}</span>
            </div>
            <div class="space-y-1">
              <span class="text-[0.65rem] uppercase tracking-widest text-primary/70 font-bold block">{t('ui.level')}</span>
              <span class="text-sm font-serif text-primary">{horse.data.specs?.level}</span>
            </div>
            <div class="space-y-1">
              <span class="text-[0.65rem] uppercase tracking-widest text-primary/70 font-bold block">{t('ui.gender')}</span>
              <span class="text-sm font-serif text-primary">{horse.data.specs?.gender}</span>
            </div>
            <div class="space-y-1">
              <span class="text-[0.65rem] uppercase tracking-widest text-primary/70 font-bold block">{t('ui.height')}</span>
              <span class="text-sm font-serif text-primary">{horse.data.specs?.height}</span>
            </div>
          </div>
          
          <div class="mt-4 pt-4 border-t border-primary/10">
             <span class="text-[10px] uppercase tracking-widest text-primary/50 font-bold mb-2 block">{t('portfolio.financial_trajectory')}</span>
             <div class="flex items-center justify-between">
                <div>
                   <span class="text-[0.60rem] text-primary/70 uppercase block">{t('portfolio.acquisition')}</span>
                   <span class="text-base font-bold text-primary">{horse.data.specs?.purchase_price || '-'}</span>
                </div>
                <div class="text-accent/50">→</div>
                <div class="text-right">
                   <span class="text-[0.60rem] text-primary/70 uppercase block">{t('portfolio.target_sale')}</span>
                   <span class="text-base font-bold text-accent">{horse.data.specs?.target_sale || '-'}</span>
                </div>
             </div>
          </div>
        </div>
        
        <div class="border-t border-gray-100 grid grid-cols-2">
           {horse.data.youtube_url ? (
             <>
               <span title="Video Coming Soon" class="flex items-center justify-center gap-2 py-3 bg-red-600/10 text-red-600/50 cursor-not-allowed border-r border-gray-100 transition-colors">
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                  <span class="text-xs font-bold uppercase tracking-widest">Video</span>
               </span>
               <a href={`/${lang}/portfolio/${horse.id.replace('.md','').split('/').slice(1).join('/')}`}  class="w-full text-center py-3 text-sm font-bold group-hover:bg-primary group-hover:text-white uppercase tracking-widest bg-bg-subtle hover:bg-primary hover:text-white transition-all text-primary/90">
                  Plan
               </a>
             </>
           ) : (
             <a href={`/${lang}/portfolio/${horse.id.replace('.md','').split('/').slice(1).join('/')}`}  class="col-span-2 w-full text-center py-3 text-sm font-bold group-hover:bg-primary group-hover:text-white uppercase tracking-widest bg-bg-subtle hover:bg-primary hover:text-white transition-all text-primary/90">
                  Investment Plan
               </a>
           )}
        </div>
      </div>
    ))}
    </div>
    
    </div> <!-- END PORTFOLIO CONTENT -->
  </div>

  <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="absolute bottom-12 right-12 z-50 w-16 h-16 opacity-[0.06] hover:opacity-100 transition-all duration-700 cursor-pointer focus:outline-none hidden md:block">
    <img src="/images/logo.webp" alt={t('ui.scroll_top')} loading="lazy" width="64" height="64" class="w-full h-full object-contain animate-slow-spin" />
  </button>
</section>

<script>
  
  
  function initGalleryFilters() {
    const filters = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.horse-card');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        filters.forEach(f => {
          f.classList.remove('active', 'text-primary', 'border-primary');
          f.classList.add('text-primary/70', 'border-primary/10');
        });
        btn.classList.add('active', 'text-primary', 'border-primary');
        btn.classList.remove('text-primary/70', 'border-primary/10');

        const filterValue = btn.getAttribute('data-filter');

        cards.forEach(card => {
          if (filterValue === 'all') {
            (card as HTMLElement).style.display = 'flex';
          } else {
            const category = card.getAttribute('data-category') || '';
            if (category.includes(filterValue!)) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          }
        });
      });
    });
  }

  const VALID_CODES = ['1111'];

  function unlockPortfolio(immediate = false) {
    const lockScreen = document.getElementById('portfolio-lock');
    const content = document.getElementById('portfolio-content');

    if (!lockScreen || !content) return;
    
    if (immediate) {
       lockScreen.classList.add('hidden');
    } else {
       lockScreen.classList.add('opacity-0', 'pointer-events-none');
       setTimeout(() => {
         lockScreen.classList.add('hidden');
       }, 700);
    }
    
    content.classList.remove('opacity-10', 'opacity-30', 'pointer-events-none', 'h-[500px]', 'overflow-hidden');
    content.classList.add('opacity-100');

    if (typeof (window as any).initReveal === 'function') {
      (window as any).initReveal();
    }
  }

  function initLock() {
    if (localStorage.getItem('equivest_v2_unlocked') === 'true') {
       unlockPortfolio(true);
       return;
    }

    const form = document.getElementById('portfolio-form');
    const input = document.getElementById('portfolio-code') as HTMLInputElement;
    const errorMsg = document.getElementById('portfolio-error');

    if (form && input && errorMsg) {
      // Remove old listeners by cloning to be safe (though on swap it's a new node anyway)
      
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const user = (document.getElementById('portfolio-user') as HTMLInputElement).value.trim();
        const code = input.value.trim();

        if (user === 'Equivest11' && code === '1111') {
          errorMsg.classList.add('hidden');
          localStorage.setItem('equivest_v2_unlocked', 'true');
          unlockPortfolio();
        } else {
          errorMsg.classList.remove('hidden');
          input.classList.add('border-red-500');
          (document.getElementById('portfolio-user') as HTMLInputElement).classList.add('border-red-500');
          input.value = '';
          form.classList.add('animate-shake');
          setTimeout(() => form.classList.remove('animate-shake'), 500);
        }
      });
    }
  }

  if (typeof initGalleryFilters === 'function') { initGalleryFilters(); }
  initLock();
  
    
    
  document.addEventListener('astro:after-swap', () => {
      if (typeof initGalleryFilters === 'function') { initGalleryFilters(); }
      initLock();
      
  });
</script>

<style>
	.animate-shake {
		animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
	}
	@keyframes shake {
		10%, 90% { transform: translate3d(-1px, 0, 0); }
		20%, 80% { transform: translate3d(2px, 0, 0); }
		30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
		40%, 60% { transform: translate3d(4px, 0, 0); }
	}
</style>
