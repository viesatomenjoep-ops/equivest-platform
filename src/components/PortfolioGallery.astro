---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const horses = await getCollection('portfolio');
const featuredHorses = horses.filter(h => h.data.featured && !h.data.sold).slice(0, 3);
const allHorses = horses.filter(h => !h.data.sold).sort((a, b) => (b.data.featured ? 1 : -1));
---

<section id="portfolio" class="py-12 md:py-24 bg-bg-subtle relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
      <div class="space-y-4 max-w-2xl">
        <span class="text-accent text-xs font-bold uppercase tracking-[0.3em] block">Our Collection</span>
        <h2 class="text-4xl md:text-5xl font-serif text-primary leading-tight">
          {t('portfolio.title')}
        </h2>
        <p class="text-primary/60 text-lg font-light leading-relaxed">
           Explore our selection of elite showjumpers from the finest breeding lines in Europe. Each horse is hand-picked for investment potential.
        </p>
      </div>
      <div class="flex flex-wrap gap-4 mt-6 md:mt-0">
         <button class="filter-btn active text-primary font-bold uppercase tracking-widest border-b border-primary pb-2 text-[10px] md:text-xs transition-colors" data-filter="all">All</button>
         <button class="filter-btn text-primary/40 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-[10px] md:text-xs transition-colors" data-filter="Grand Prix">Grand Prix</button>
         <button class="filter-btn text-primary/40 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-[10px] md:text-xs transition-colors" data-filter="Youngster">Youngster</button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10">
      {allHorses.map((horse, index) => (
        <div class="horse-card reveal reveal-scale bg-white group overflow-hidden shadow-sm hover:shadow-premium transition-shadow flex flex-col h-full" style={`transition-duration: 1200ms; transition-delay: ${index * 150}ms`} data-level={horse.data.specs?.level}>
          <div class="aspect-[16/10] overflow-hidden relative">
            {typeof horse.data.image === 'string' ? (
              <Image 
                src={horse.data.image} 
                alt={horse.data.title} 
                inferSize={true}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
            ) : (
              <Image 
                src={horse.data.image} 
                alt={horse.data.title} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
            )}
            {horse.data.featured && (
              <div class="absolute top-4 left-4 bg-primary text-accent text-[10px] font-bold uppercase tracking-widest px-3 py-1 shadow-xl">
                 Prime Selection
              </div>
            )}
            
            <!-- YouTube Overlay -->
            {horse.data.youtube_url && (
              <button class="yt-play-btn absolute inset-0 bg-primary/20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer z-10" data-url={horse.data.youtube_url} aria-label="Play Video">
                 <div class="w-12 h-12 bg-white flex items-center justify-center rounded-full text-primary scale-90 group-hover:scale-100 transition-transform shadow-xl">
                    <svg class="w-6 h-6 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                 </div>
              </button>
            )}
          </div>
          
          <div class="p-8 flex-grow flex flex-col">
            <h3 class="text-2xl font-serif text-primary mb-3 group-hover:text-accent transition-colors">{horse.data.title}</h3>
            <p class="text-primary/70 text-sm font-light mb-6 line-clamp-2">
              {horse.data.description}
            </p>
            
            <div class="mt-auto grid grid-cols-2 gap-y-4 border-t border-gray-50 pt-6">
              <div class="space-y-1">
                <span class="text-[9px] uppercase tracking-widest text-primary/40 font-bold block">Age</span>
                <span class="text-sm font-serif text-primary">{horse.data.specs?.age} Years</span>
              </div>
              <div class="space-y-1">
                <span class="text-[9px] uppercase tracking-widest text-primary/40 font-bold block">Level</span>
                <span class="text-sm font-serif text-primary">{horse.data.specs?.level}</span>
              </div>
              <div class="space-y-1">
                <span class="text-[9px] uppercase tracking-widest text-primary/40 font-bold block">Gender</span>
                <span class="text-sm font-serif text-primary">{horse.data.specs?.gender}</span>
              </div>
              <div class="space-y-1">
                <span class="text-[9px] uppercase tracking-widest text-primary/40 font-bold block">Height</span>
                <span class="text-sm font-serif text-primary">{horse.data.specs?.height}</span>
              </div>
            </div>
          </div>
          
          <div class="border-t border-gray-100 p-4">
             <a href={`/${lang}/contact`} class="block w-full text-center py-3 text-[11px] font-bold uppercase tracking-[0.2em] bg-bg-subtle hover:bg-primary hover:text-white transition-all text-primary/60">
                Inquire Details
             </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Interactive Subtle Scroll to Top Logo -->
  <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="absolute bottom-12 right-12 z-50 w-40 h-40 opacity-[0.06] hover:opacity-100 transition-all duration-700 cursor-pointer focus:outline-none mix-blend-multiply drop-shadow-2xl hidden md:block">
    <img src="/images/logo.png" alt="Scroll to top" class="w-full h-full object-contain" />
  </button>

  <!-- YouTube Modal -->
  <div id="yt-modal" class="fixed inset-0 z-[200] bg-primary/95 backdrop-blur-md hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
    <button id="yt-close" class="absolute top-8 right-8 text-white/50 hover:text-white p-4 transition-colors">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <div class="w-full max-w-5xl aspect-video px-4 md:px-12 w-full">
      <iframe id="yt-iframe" class="w-full h-full shadow-2xl border border-white/10 rounded-xl" src="" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
    </div>
  </div>
</section>

<script>
  function initGalleryFilters() {
    const filters = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.horse-card');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active states
        filters.forEach(f => {
          f.classList.remove('active', 'text-primary', 'border-primary');
          f.classList.add('text-primary/40', 'border-primary/10');
        });
        btn.classList.add('active', 'text-primary', 'border-primary');
        btn.classList.remove('text-primary/40', 'border-primary/10');

        const filterValue = btn.getAttribute('data-filter');

        cards.forEach(card => {
          if (filterValue === 'all') {
            (card as HTMLElement).style.display = 'flex';
          } else {
            const level = card.getAttribute('data-level') || '';
            // Simple string matching for now
            if (level.includes(filterValue!)) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          }
        });
      });
    });
  }

  function initVideoModal() {
    const playBtns = document.querySelectorAll('.yt-play-btn');
    const modal = document.getElementById('yt-modal');
    const iframe = document.getElementById('yt-iframe') as HTMLIFrameElement;
    const closeBtn = document.getElementById('yt-close');

    if (!modal || !iframe) return;

    const extractVideoID = (url: string) => {
      const regExp = /^.*(youtu.be\/|v\/|e\/|u\/\w+\/|embed\/|v=)([^#\&\?]*).*/;
      const match = url.match(regExp);
      return (match && match[2].length === 11) ? match[2] : null;
    };

    const closeModal = () => {
      modal.classList.remove('opacity-100');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        iframe.src = '';
      }, 300);
      document.body.style.overflow = '';
    };

    playBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = btn.getAttribute('data-url');
        if (!url) return;
        
        const videoId = extractVideoID(url);
        if (videoId) {
          iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          // small delay to allow display flex to apply before transitioning opacity
          setTimeout(() => {
            modal.classList.add('opacity-100');
          }, 10);
          document.body.style.overflow = 'hidden';
        }
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  }

  function init() {
    initGalleryFilters();
    initVideoModal();
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
