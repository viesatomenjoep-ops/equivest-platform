---
import { getCollection, render } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const horses = await getCollection('portfolio');
const allHorses = horses.filter(h => !h.data.sold).sort((a, b) => (b.data.premium ? 1 : -1));


const allHorsesWithContent = await Promise.all(
  allHorses.map(async (horse) => {
    const { Content } = await render(horse);
    return {
      slug: horse.slug,
      data: horse.data,
      category: horse.data.category || '',
      Content
    };
  })
);
---

<section id="portfolio" class="py-12 md:py-24 bg-bg-subtle relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-8 md:mb-16 gap-8">
      <div class="space-y-4 max-w-2xl">
        <span class="text-accent text-xl font-bold uppercase tracking-[0.3em] block">Our Collection</span>
        <h2 class="text-4xl md:text-5xl font-serif text-primary leading-tight">
          {t('portfolio.title')}
        </h2>
        <p class="text-primary/90 text-xl font-medium leading-relaxed">
           Explore our selection of elite showjumpers from the finest breeding lines in Europe. Each horse is hand-picked for investment potential.
        </p>
      </div>
    </div>

    <!-- THE LOCK SCREEN OVERLAY -->
    <div id="portfolio-lock" class="absolute inset-0 z-[50] flex flex-col items-center justify-start bg-bg-subtle/95 backdrop-blur-sm w-full transition-all duration-700 pt-32 px-4">
      <div class="max-w-md w-full space-y-6 md:space-y-8 text-center reveal reveal-up bg-white p-8 md:p-14 shadow-2xl border border-gray-100">
        <img src="/images/logo.png" alt="Equivest Access" class="w-16 h-16 md:w-20 md:h-20 mx-auto object-contain brightness-0 animate-slow-spin" />
        <h2 class="text-3xl md:text-4xl font-serif text-primary">Private Access</h2>
        <p class="text-primary/70 text-base md:text-lg">Please enter your exclusive access code to view our investment portfolio.</p>
        
        <form id="portfolio-form" class="mt-8 space-y-4">
          <div>
            <input 
              type="password" 
              id="portfolio-code"
              required
              class="w-full bg-bg-subtle border border-primary/20 p-4 text-center tracking-[0.2em] font-bold text-primary focus:outline-none focus:border-accent transition-colors"
              placeholder="ENTER CODE"
            />
            <p id="portfolio-error" class="text-red-500 mt-2 text-sm font-bold uppercase tracking-widest hidden">Invalid Access Code</p>
          </div>
          <button type="submit" class="w-full bg-primary text-white font-bold uppercase tracking-[0.2em] py-4 hover:bg-accent transition-colors">
            Unlock Collection
          </button>
        </form>
        
        <p class="text-xs md:text-sm text-primary/50 mt-6">To request access to our current assets, please contact your Equivest representative.</p>
      </div>
    </div>

    <!-- THE PORTFOLIO CONTENT (Blurred by default) -->
    <div id="portfolio-content" class="opacity-10 select-none pointer-events-none transition-all duration-1000 h-[500px] overflow-hidden">
      
      <div class="flex flex-wrap gap-4 mb-8">
         <button class="filter-btn active text-primary font-bold uppercase tracking-widest border-b border-primary pb-2 text-lg md:text-xl transition-colors" data-filter="all">All</button>
         <button class="filter-btn text-primary/70 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-lg md:text-xl transition-colors" data-filter="Hunters">Hunters</button>
         <button class="filter-btn text-primary/70 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-lg md:text-xl transition-colors" data-filter="Jumpers">Jumpers</button>
         <button class="filter-btn text-primary/70 hover:text-primary font-bold uppercase tracking-widest border-b border-primary/10 hover:border-primary/50 pb-2 text-lg md:text-xl transition-colors" data-filter="Pony's">Pony's</button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10">
        {allHorsesWithContent.map((horse, index) => (
          <div class="horse-card reveal reveal-scale bg-white group overflow-hidden shadow-sm hover:shadow-premium transition-shadow flex flex-col h-full" style={`transition-delay: ${(index % 3) * 75}ms`} data-category={horse.category}>
            <div class="aspect-[16/10] overflow-hidden relative cursor-pointer" onclick={`openModal('${horse.slug}')`}>
              {typeof horse.data.image === 'string' ? (
                <img 
                  src={horse.data.image} 
                  alt={horse.data.title} 
                  onerror="this.onerror=null; this.src='/images/logo.png'; this.style.objectFit='contain'; this.style.padding='3rem'; this.style.opacity='0.2';"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                />
              ) : (
                <Image 
                  src={horse.data.image} 
                  alt={horse.data.title} 
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                />
              )}
        </div>
        
        <div class="p-8 flex-grow flex flex-col">
          <div class="flex items-center space-x-3 mb-3 cursor-pointer" onclick={`openModal('${horse.slug}')`}>
            <img src="/images/logo.png" alt="Equivest" class="w-16 h-16 object-contain brightness-0" />
            <h3 class="text-2xl font-serif text-primary group-hover:text-accent transition-colors">{horse.data.title}</h3>
          </div>
          <p class="text-primary/70 text-lg font-medium mb-6 line-clamp-2">
            {horse.data.description}
          </p>
          
          <div class="mt-auto grid grid-cols-2 gap-y-4 border-t border-gray-50 pt-6">
            <div class="space-y-1">
              <span class="text-lg uppercase tracking-widest text-primary/70 font-bold block">Age</span>
              <span class="text-lg font-serif text-primary">{horse.data.specs?.age} Years</span>
            </div>
            <div class="space-y-1">
              <span class="text-lg uppercase tracking-widest text-primary/70 font-bold block">Level</span>
              <span class="text-lg font-serif text-primary">{horse.data.specs?.level}</span>
            </div>
            <div class="space-y-1">
              <span class="text-lg uppercase tracking-widest text-primary/70 font-bold block">Gender</span>
              <span class="text-lg font-serif text-primary">{horse.data.specs?.gender}</span>
            </div>
            <div class="space-y-1">
              <span class="text-lg uppercase tracking-widest text-primary/70 font-bold block">Height</span>
              <span class="text-lg font-serif text-primary">{horse.data.specs?.height}</span>
            </div>
          </div>
        </div>
        
        <div class="border-t border-gray-100 grid grid-cols-2">
             <button onclick={`openModal('${horse.slug}')`} class="col-span-2 w-full text-center py-4 text-sm font-bold uppercase tracking-widest bg-bg-subtle hover:bg-primary hover:text-white transition-all text-primary/90">
                Investment Plan
             </button>
        </div>
      </div>
    ))}
    </div>
    
    <!-- MODALS -->
    {allHorsesWithContent.map((horse) => {
      const Content = horse.Content;
      return (
      <div id={`modal-${horse.slug}`} class="fixed inset-0 z-[1000] hidden items-center justify-center opacity-0 transition-opacity duration-500">
        <div class="absolute inset-0 bg-primary/95 backdrop-blur-md" onclick={`closeModal('${horse.slug}')`}></div>
        
        <div class="relative bg-white w-[95%] max-w-6xl h-[90vh] flex flex-col md:flex-row shadow-2xl scale-95 transition-transform duration-500 delay-100 modal-dialog overflow-hidden">
           <!-- Close -->
           <button onclick={`closeModal('${horse.slug}')`} class="absolute top-4 right-4 z-[60] w-12 h-12 bg-white/80 backdrop-blur-sm hover:bg-accent text-primary hover:text-white transition-colors border border-primary/10 rounded-full flex items-center justify-center shadow-lg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
           </button>
           
           <!-- Left: Image -->
           <div class="w-full md:w-2/5 h-48 md:h-full relative shrink-0">
             {typeof horse.data.image === 'string' ? (
                <img src={horse.data.image} class="w-full h-full object-cover" onerror="this.onerror=null; this.src='/images/logo.png'; this.style.objectFit='contain'; this.style.padding='3rem'; this.style.opacity='0.2';" />
             ) : (
                <Image src={horse.data.image} alt={horse.data.title} class="w-full h-full object-cover" />
             )}
           </div>
           
           <!-- Right: Content -->
           <div class="w-full md:w-3/5 p-5 md:p-14 overflow-y-auto bg-bg-subtle relative">
              <div class="max-w-2xl mx-auto">
                  <span class="text-accent text-sm font-bold uppercase tracking-[0.3em] mb-3 block">Investment Prospectus</span>
                  <h2 class="text-2xl md:text-5xl font-serif text-primary mb-6 md:mb-10">{horse.data.title}</h2>
                  
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-6 mb-6 pb-6 md:mb-12 md:pb-10 border-b border-primary/10">
                    <div class="space-y-2">
                      <span class="text-xs uppercase tracking-widest text-primary/50 font-bold block">Age</span>
                      <span class="text-sm md:text-xl font-serif text-primary">{horse.data.specs?.age} Years</span>
                    </div>
                    <div class="space-y-2">
                      <span class="text-xs uppercase tracking-widest text-primary/50 font-bold block">Level</span>
                      <span class="text-sm md:text-xl font-serif text-primary">{horse.data.specs?.level}</span>
                    </div>
                    <div class="space-y-2">
                      <span class="text-xs uppercase tracking-widest text-primary/50 font-bold block">Gender</span>
                      <span class="text-sm md:text-xl font-serif text-primary">{horse.data.specs?.gender}</span>
                    </div>
                    <div class="space-y-2">
                      <span class="text-xs uppercase tracking-widest text-primary/50 font-bold block">Height</span>
                      <span class="text-sm md:text-xl font-serif text-primary">{horse.data.specs?.height}</span>
                    </div>
                  </div>

                  <div class="prose prose-lg prose-primary max-w-none prose-headings:font-serif prose-headings:text-primary prose-a:text-accent prose-strong:text-primary/90">
                      <Content />
                  </div>
                  
                  <div class="mt-8 pt-6 md:mt-16 md:pt-10 border-t border-primary/10 flex flex-col sm:flex-row gap-4">
                     <a href="https://wa.me/15613010984" target="_blank" class="text-center px-6 py-4 md:px-10 md:py-5 bg-accent text-white uppercase font-bold text-sm md:text-base tracking-widest hover:bg-primary transition-colors shadow-xl w-full">
                        Secure Investment
                     </a>
                  </div>
              </div>
           </div>
        </div>
      </div>
      );
    })}

    </div> <!-- END PORTFOLIO CONTENT -->
  </div>

  <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="absolute bottom-12 right-12 z-50 w-16 h-16 opacity-[0.06] hover:opacity-100 transition-all duration-700 cursor-pointer focus:outline-none mix-blend-multiply drop-shadow-2xl hidden md:block">
    <img src="/images/logo.png" alt="Scroll to top" class="w-full h-full object-contain animate-slow-spin" />
  </button>
</section>

<script>
  (window as any).openModal = function(slug: string) {
     const modal = document.getElementById('modal-' + slug);
     const dialog = modal?.querySelector('.modal-dialog');
     if (modal && dialog) {
        modal.classList.remove('hidden');
        void modal.offsetWidth; // trigger reflow
        modal.classList.remove('opacity-0');
        dialog.classList.remove('scale-95');
        dialog.classList.add('scale-100');
        document.body.style.overflow = 'hidden';
     }
  };

  (window as any).closeModal = function(slug: string) {
     const modal = document.getElementById('modal-' + slug);
     const dialog = modal?.querySelector('.modal-dialog');
     if (modal && dialog) {
        modal.classList.add('opacity-0');
        if(dialog) {
            dialog.classList.remove('scale-100');
            dialog.classList.add('scale-95');
        }
        setTimeout(() => {
           modal.classList.add('hidden');
           document.body.style.overflow = '';
        }, 500);
     }
  };

  function initGalleryFilters() {
    const filters = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.horse-card');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        filters.forEach(f => {
          f.classList.remove('active', 'text-primary', 'border-primary');
          f.classList.add('text-primary/70', 'border-primary/10');
        });
        btn.classList.add('active', 'text-primary', 'border-primary');
        btn.classList.remove('text-primary/70', 'border-primary/10');

        const filterValue = btn.getAttribute('data-filter');

        cards.forEach(card => {
          if (filterValue === 'all') {
            (card as HTMLElement).style.display = 'flex';
          } else {
            const category = card.getAttribute('data-category') || '';
            if (category.includes(filterValue!)) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          }
        });
      });
    });
  }

  // Lock logic
  const form = document.getElementById('portfolio-form');
  const lockScreen = document.getElementById('portfolio-lock');
  const content = document.getElementById('portfolio-content');
  const input = document.getElementById('portfolio-code') as HTMLInputElement;
  const errorMsg = document.getElementById('portfolio-error');

  const VALID_CODES = ['1111'];

  function unlockPortfolio(immediate = false) {
    if (!lockScreen || !content) return;
    
    if (immediate) {
       lockScreen.classList.add('hidden');
    } else {
       lockScreen.classList.add('opacity-0', 'pointer-events-none');
       setTimeout(() => {
         lockScreen.classList.add('hidden');
       }, 700);
    }
    
    content.classList.remove('opacity-10', 'pointer-events-none', 'h-[500px]', 'overflow-hidden');
    content.classList.add('opacity-100');

    if (typeof (window as any).initReveal === 'function') {
      (window as any).initReveal();
    }
  }

  function initLock() {
    if (localStorage.getItem('equivest_unlocked') === 'true') {
       unlockPortfolio(true);
       return;
    }

    if (form && lockScreen && content && input && errorMsg) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const code = input.value.trim().toUpperCase();

        if (VALID_CODES.includes(code)) {
          errorMsg.classList.add('hidden');
          localStorage.setItem('equivest_unlocked', 'true');
          unlockPortfolio();
        } else {
          errorMsg.classList.remove('hidden');
          input.classList.add('border-red-500');
          input.value = '';
          form.classList.add('animate-shake');
          setTimeout(() => form.classList.remove('animate-shake'), 500);
        }
      });
    }
  }

  initGalleryFilters();
  initLock();
  
  document.addEventListener('astro:after-swap', () => {
      initGalleryFilters();
      initLock();
  });
</script>

<style>
	.animate-shake {
		animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
	}
	@keyframes shake {
		10%, 90% { transform: translate3d(-1px, 0, 0); }
		20%, 80% { transform: translate3d(2px, 0, 0); }
		30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
		40%, 60% { transform: translate3d(4px, 0, 0); }
	}
</style>
