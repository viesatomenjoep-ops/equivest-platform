<script>
  (window as any).openModal = function(slug: string) {
     const modal = document.getElementById('modal-' + slug);
     const dialog = modal?.querySelector('.modal-dialog');
     if (modal && dialog) {
        modal.classList.replace('hidden', 'flex');
        void modal.offsetWidth; // trigger reflow
        modal.classList.remove('opacity-0');
        dialog.classList.remove('scale-95');
        dialog.classList.add('scale-100');
        document.body.style.overflow = 'hidden';
        
        // Update URL state for native back-button functionality
        if (history.pushState) {
            history.pushState(null, '', '#' + slug);
        } else {
            window.location.hash = '#' + slug;
        }
     }
  };

  (window as any).closeModal = function(slug: string) {
     const modal = document.getElementById('modal-' + slug);
     const dialog = modal?.querySelector('.modal-dialog');
     if (modal && dialog) {
        modal.classList.add('opacity-0');
        if(dialog) {
            dialog.classList.remove('scale-100');
            dialog.classList.add('scale-95');
        }
        setTimeout(() => {
           modal.classList.replace('flex', 'hidden');
           document.body.style.overflow = '';
           
           // Clear URL hash when closing manually
           if (window.location.hash === '#' + slug) {
               if (history.pushState) {
                   history.pushState(null, '', window.location.pathname + window.location.search);
               } else {
                   window.location.hash = '';
               }
           }
        }, 500);
     }
  };

  function initGalleryFilters() {
    const filters = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.horse-card');

    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        filters.forEach(f => {
          f.classList.remove('active', 'text-primary', 'border-primary');
          f.classList.add('text-primary/70', 'border-primary/10');
        });
        btn.classList.add('active', 'text-primary', 'border-primary');
        btn.classList.remove('text-primary/70', 'border-primary/10');

        const filterValue = btn.getAttribute('data-filter');

        cards.forEach(card => {
          if (filterValue === 'all') {
            (card as HTMLElement).style.display = 'flex';
          } else {
            const category = card.getAttribute('data-category') || '';
            if (category.includes(filterValue!)) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          }
        });
      });
    });
  }

  const VALID_CODES = ['1111'];

  function unlockPortfolio(immediate = false) {
    const lockScreen = document.getElementById('portfolio-lock');
    const content = document.getElementById('portfolio-content');

    if (!lockScreen || !content) return;
    
    if (immediate) {
       lockScreen.classList.add('hidden');
    } else {
       lockScreen.classList.add('opacity-0', 'pointer-events-none');
       setTimeout(() => {
         lockScreen.classList.add('hidden');
       }, 700);
    }
    
    content.classList.remove('opacity-10', 'opacity-30', 'pointer-events-none', 'h-[500px]', 'overflow-hidden');
    content.classList.add('opacity-100');

    if (typeof (window as any).initReveal === 'function') {
      (window as any).initReveal();
    }
  }

  function initLock() {
    if (localStorage.getItem('equivest_v2_unlocked') === 'true') {
       unlockPortfolio(true);
       return;
    }

    const form = document.getElementById('portfolio-form');
    const input = document.getElementById('portfolio-code') as HTMLInputElement;
    const errorMsg = document.getElementById('portfolio-error');

    if (form && input && errorMsg) {
      // Remove old listeners by cloning to be safe (though on swap it's a new node anyway)
      
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const user = (document.getElementById('portfolio-user') as HTMLInputElement).value.trim();
        const code = input.value.trim();

        if (user === 'Equivest11' && code === '1111') {
          errorMsg.classList.add('hidden');
          localStorage.setItem('equivest_v2_unlocked', 'true');
          unlockPortfolio();
        } else {
          errorMsg.classList.remove('hidden');
          input.classList.add('border-red-500');
          (document.getElementById('portfolio-user') as HTMLInputElement).classList.add('border-red-500');
          input.value = '';
          form.classList.add('animate-shake');
          setTimeout(() => form.classList.remove('animate-shake'), 500);
        }
      });
    }
  }

  if (typeof initGalleryFilters === 'function') { initGalleryFilters(); }
  initLock();
  
  function syncHashState() {
      const hash = window.location.hash.substring(1);
      if (hash) {
          const m = document.getElementById('modal-' + hash);
          if (m && m.classList.contains('hidden')) {
              // Open modal if it exists natively in HTML
              (window as any).openModal(hash);
          }
      } else {
          // If returning to roots, close active modals
          document.querySelectorAll('[id^="modal-"]').forEach(m => {
              if (!m.classList.contains('hidden')) {
                  (window as any).closeModal(m.id.replace('modal-', ''));
              }
          });
      }
  }

  // Bind to native history changes (Back/Forward arrows)
  window.addEventListener('hashchange', syncHashState);
  
  // Sync on initial load
  syncHashState();
  
  function syncModalScrolls() {
      document.querySelectorAll('.modal-scroll-area').forEach(area => {
          // Cleanup old listeners to prevent memory leaking crashes
          if ((area as any)._modalScrollHandler) {
              area.removeEventListener('scroll', (area as any)._modalScrollHandler);
          }
          
          let ticking = false;
          (area as any)._modalScrollHandler = (e: any) => {
              if (!ticking) {
                  window.requestAnimationFrame(() => {
                      const el = e.currentTarget as HTMLElement;
                      const ind = el.querySelector('.indicator-dynamic') as HTMLElement;
                      if (ind) {
                          const maxScroll = el.scrollHeight - el.clientHeight || 1;
                          let progress = el.scrollTop / maxScroll;
                          if (progress > 1) progress = 1;
                          ind.style.transform = `translateY(${progress * 100}%)`;
                      }
                      ticking = false;
                  });
                  ticking = true;
              }
          };
          
          area.addEventListener('scroll', (area as any)._modalScrollHandler, { passive: true });
      });
  }
  syncModalScrolls();
  
  document.addEventListener('astro:after-swap', () => {
      if (typeof initGalleryFilters === 'function') { initGalleryFilters(); }
      initLock();
      syncHashState();
      syncModalScrolls();
  });
</script>

<style>
	.animate-shake {
		animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
	}
	@keyframes shake {
		10%, 90% { transform: translate3d(-1px, 0, 0); }
		20%, 80% { transform: translate3d(2px, 0, 0); }
		30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
		40%, 60% { transform: translate3d(4px, 0, 0); }
	}
</style>
