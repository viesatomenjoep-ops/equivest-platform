---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Mock placeholders until real images are provided
const mockImgHeather = "https://images.unsplash.com/photo-1598974357801-cbca100e65d3?w=800&q=80";
const mockImgRider = "https://images.unsplash.com/photo-1553285991-4c7cb1ab82ca?w=800&q=80";
---

<div class="pt-24 mt-16 md:mt-24 border-t border-gray-100 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16 md:mb-24 flex flex-col md:flex-row md:items-start md:justify-between gap-8">
      <div class="max-w-2xl reveal reveal-up">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif text-primary mb-6 leading-tight">
          {t("team.title")}
        </h2>
        <p class="text-lg md:text-xl text-primary/80 font-medium leading-relaxed">
          {t("team.intro1")}
        </p>
        <p class="text-base text-primary/70 leading-relaxed mt-4">
          {t("team.intro2")}
        </p>
      </div>
    </div>

    <!-- Team Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-24">
      
      <!-- Team Member 1 -->
      <div class="group reveal reveal-up delay-100">
        <div class="relative w-[60%] md:w-[40%] aspect-[4/3] md:aspect-[16/9] mb-8 overflow-hidden rounded-sm bg-primary/5 flex flex-col items-center justify-center">
          <img src="/images/Heather.jpeg" alt="Heather Field" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.parentElement.style.display='none'" />
          <div class="absolute bottom-4 right-4 bg-white p-2 rounded-sm shadow-md flex items-center justify-center">
            <span class="text-2xl" title="USA">🇺🇸</span>
          </div>
        </div>
        <div class="space-y-4">
          <div>
            <span class="text-accent text-sm font-bold uppercase tracking-[0.2em]">{t("team.role1")}</span>
            <h3 class="text-2xl md:text-3xl font-serif text-primary mt-1">{t("team.name1")}</h3>
          </div>
          <p class="text-primary/70 leading-relaxed text-base">
            {t("team.desc1")}
          </p>
          <p class="text-primary italic font-medium pt-2">
             {t("team.fact1")}
          </p>
        </div>
      </div>

      <!-- Team Member 2 -->
      <div class="group reveal reveal-up delay-200">
        <div class="relative w-[60%] md:w-[40%] aspect-[4/3] md:aspect-[16/9] mb-8 overflow-hidden rounded-sm bg-primary/5 flex items-center justify-center">
          <img src="/images/Tyler.jpeg" alt="Tyler Petrie" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.parentElement.style.display='none'" />
          <div class="absolute bottom-4 right-4 bg-white p-2 rounded-sm shadow-md flex items-center justify-center">
            <span class="text-2xl" title="USA">🇺🇸</span>
          </div>
        </div>
        <div class="space-y-4">
          <div>
            <span class="text-accent text-sm font-bold uppercase tracking-[0.2em]">{t("team.role2")}</span>
            <h3 class="text-2xl md:text-3xl font-serif text-primary mt-1">{t("team.name2")}</h3>
          </div>
          <p class="text-primary/70 leading-relaxed text-base">
            {t("team.desc2")}
          </p>
        </div>
      </div>
      
      <!-- Team Member 3 -->
      <div class="group reveal reveal-up delay-100">
        <div class="relative w-[60%] md:w-[40%] aspect-[4/3] md:aspect-[16/9] mb-8 overflow-hidden rounded-sm bg-primary/5 flex items-center justify-center">
          <img src="/images/Christelle.jpeg" alt="Christelle Littunen" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.parentElement.style.display='none'" />
          <div class="absolute bottom-4 right-4 bg-white p-2 rounded-sm shadow-md flex items-center justify-center">
            <span class="text-2xl" title="EU">🇪🇺</span>
          </div>
        </div>
        <div class="space-y-4">
          <div>
            <span class="text-accent text-sm font-bold uppercase tracking-[0.2em]">{t("team.role3")}</span>
            <h3 class="text-2xl md:text-3xl font-serif text-primary mt-1">{t("team.name3")}</h3>
          </div>
          <p class="text-primary/70 leading-relaxed text-base">
            {t("team.desc3")}
          </p>
          <p class="text-primary italic font-medium pt-2">
            {t("team.fact3")}
          </p>
        </div>
      </div>

      <!-- Team Member 4 -->
      <div class="group reveal reveal-up delay-200">
        <div class="relative w-[60%] md:w-[40%] aspect-[4/3] md:aspect-[16/9] mb-8 overflow-hidden rounded-sm bg-primary/5 flex items-center justify-center">
          <img src="/images/Aurélie.jpeg" alt="Aurelie Mordefroy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.parentElement.style.display='none'" />
          <div class="absolute bottom-4 right-4 bg-white p-2 rounded-sm shadow-md flex items-center justify-center">
            <span class="text-2xl" title="EU">🇪🇺</span>
          </div>
        </div>
        <div class="space-y-4">
          <div>
            <span class="text-accent text-sm font-bold uppercase tracking-[0.2em]">{t("team.role4")}</span>
            <h3 class="text-2xl md:text-3xl font-serif text-primary mt-1">{t("team.name4")}</h3>
          </div>
          <p class="text-primary/70 leading-relaxed text-base">
            {t("team.desc4")}
          </p>
          <p class="text-primary italic font-medium pt-2">
             {t("team.fact4")}
          </p>
        </div>
      </div>
      
      <!-- Team Member 5 -->
      <div class="group reveal reveal-up delay-100">
        <div class="relative w-[60%] md:w-[40%] aspect-[4/3] md:aspect-[16/9] mb-8 overflow-hidden rounded-sm bg-primary/5 flex items-center justify-center">
          <img src="/images/Kyara.jpeg" alt="Kyara Murreli" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.parentElement.style.display='none'" />
          <div class="absolute bottom-4 right-4 bg-white p-2 rounded-sm shadow-md flex items-center justify-center">
            <span class="text-2xl" title="Global">🌎</span>
          </div>
        </div>
        <div class="space-y-4">
          <div>
            <span class="text-accent text-sm font-bold uppercase tracking-[0.2em]">{t("team.role5")}</span>
            <h3 class="text-2xl md:text-3xl font-serif text-primary mt-1">{t("team.name5")}</h3>
          </div>
          <p class="text-primary/70 leading-relaxed text-base">
            {t("team.desc5")}
          </p>
        </div>
      </div>

      <!-- Team Member 6 -->
      <div class="group reveal reveal-up delay-200">
        <div class="relative w-[60%] md:w-[40%] aspect-[4/3] md:aspect-[16/9] mb-8 overflow-hidden rounded-sm bg-primary/5 flex items-center justify-center">
          <img src="/images/Evelyn.jpeg" alt="Eveline van Gruisen" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.parentElement.style.display='none'" />
          <div class="absolute bottom-4 right-4 bg-white p-2 rounded-sm shadow-md flex items-center justify-center">
            <span class="text-2xl" title="Global">🌎</span>
          </div>
        </div>
        <div class="space-y-4">
          <div>
            <span class="text-accent text-sm font-bold uppercase tracking-[0.2em]">{t("team.role6")}</span>
            <h3 class="text-2xl md:text-3xl font-serif text-primary mt-1">{t("team.name6")}</h3>
          </div>
          <p class="text-primary/70 leading-relaxed text-base">
            {t("team.desc6")}
          </p>
        </div>
      </div>
      
      <!-- Team Member 7 -->
      <div class="group reveal reveal-up delay-100 lg:col-span-2 max-w-2xl mx-auto w-full mt-8 border-t border-gray-100 pt-16">
        <div class="relative w-[60%] md:w-[40%] mx-auto md:mx-0 aspect-[4/3] md:aspect-[16/9] mb-8 overflow-hidden rounded-sm bg-primary/5 flex items-center justify-center">
          <img src="/images/Tom.jpeg" alt="Tom van Biene" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.parentElement.style.display='none'" />
          <div class="absolute bottom-4 right-4 bg-white p-2 rounded-sm shadow-md flex items-center justify-center">
            <span class="text-2xl" title="Global">🌎</span>
          </div>
        </div>
        <div class="space-y-4 text-center md:text-left md:flex gap-12 items-center">
          <div class="shrink-0 mb-4 md:mb-0">
            <span class="text-accent text-sm font-bold uppercase tracking-[0.2em] block">{t("team.role7")}</span>
            <h3 class="text-2xl md:text-3xl font-serif text-primary mt-1">{t("team.name7")}</h3>
          </div>
          <p class="text-primary/70 leading-relaxed text-base">
            {t("team.desc7")}
          </p>
        </div>
      </div>

    </div>

    <!-- Closing Statement -->
    <div class="mt-20 md:mt-32 max-w-4xl mx-auto text-center reveal reveal-up bg-bg-subtle p-8 md:p-14 border border-primary/5 rounded-sm">
      <p class="text-xl md:text-2xl font-serif leading-relaxed text-primary/90 italic">
        "{t("team.closing")}"
      </p>
    </div>
  </div>
</div>
