---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import RoiCalculatorTabs from '../../components/RoiCalculatorTabs.jsx';
import Contact from '../../components/Contact.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'de' } },
    { params: { lang: 'es' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="ROI Calculators | Equivest Elite Investments" lang={lang}>
	<Header />
	
	<div id="main-content" class="min-h-screen bg-bg-light">
		<div class="pt-8 pb-12 md:pt-12 md:pb-24 reveal reveal-up delay-200">
		   <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
   			 <div class="text-center mb-10 md:mb-16">
                 <span class="text-accent text-sm font-bold uppercase tracking-[0.3em] mb-4 block">Calculators</span>
                 <h2 class="text-3xl md:text-5xl font-serif text-primary leading-tight">Investment Projection</h2>
               </div>
			 <RoiCalculatorTabs lang={lang} client:load />
		   </div>
		</div>
		
		<div class="mt-12 reveal reveal-up">
			<Contact />
		</div>
	</div>
</Layout>
