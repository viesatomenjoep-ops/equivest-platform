---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PortfolioGallery from '../../components/PortfolioGallery.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'de' } },
    { params: { lang: 'es' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="Portfolio | Equivest Elite Investments" lang={lang}>
	<Header />
	
	<div id="main-content" class="min-h-screen bg-bg-subtle">
		<!-- The Full Gallery -->
		<div class="reveal reveal-up delay-200">
			<!-- Note: We use the existing PortfolioGallery but with an override to ensure it looks good as a standalone page -->
			<PortfolioGallery />
		</div>
	</div>
</Layout>
