---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import About from "../../components/About.astro";
import VideoShowcase from "../../components/VideoShowcase.astro";
import PortfolioGallery from "../../components/PortfolioGallery.astro";

import References from "../../components/References.astro";
import Partners from "../../components/Partners.astro";
import Reviews from "../../components/Reviews.astro";
import RoiCalculatorTabs from "../../components/RoiCalculatorTabs.jsx";
import News from "../../components/News.astro";
import Contact from "../../components/Contact.astro";
import Faq from "../../components/Faq.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { Image } from "astro:assets";
import heroImg from "../../assets/images/hero.webp";

export function getStaticPaths() {
	return [
		{ params: { lang: "en" } },
		{ params: { lang: "nl" } },
		{ params: { lang: "de" } },
		{ params: { lang: "es" } },
	];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t("hero.title")} lang={lang}>
	<Header />

	<div id="site-wrapper">
		<!-- Hero Section -->
		<section
			class="relative h-[90vh] flex items-center justify-center overflow-hidden premium-gradient text-white pt-24"
		>
			<div class="absolute inset-0 opacity-90">
				<Image
					src={heroImg}
					alt="Elite Jumper"
					loading="eager"
					fetchpriority="high"
					class="w-full h-full object-cover object-top"
				/>
				<div
					class="absolute inset-0 bg-gradient-to-b from-primary/60 via-primary/20 to-primary/90"
				>
				</div>
			</div>

			<div
				class="relative z-10 max-w-5xl mx-auto px-4 text-center space-y-8"
			>
				<div
					class="inline-flex items-center space-x-2 px-4 py-2 bg-white/10 border border-white/20 rounded-full mb-4"
				>
					<span
						class="w-2 h-2 bg-accent-light rounded-full animate-pulse"
					></span>
					<span
						class="text-lg font-bold uppercase tracking-[0.2em] text-white"
						>{t("hero.subtitle")}</span
					>
				</div>
				<h1
					class="text-5xl md:text-8xl font-serif text-white leading-[1.1] tracking-tight reveal reveal-up delay-100"
				>
					{
						t("hero.title")
							.split(" ")
							.map((word, i) =>
								i === 2 ? (
									<span class="text-accent-light italic">
										{word}{" "}
									</span>
								) : (
									word + " "
								),
							)
					}
				</h1>
				<p
					class="text-2xl md:text-2xl font-medium text-white/80 max-w-2xl mx-auto leading-relaxed reveal reveal-up delay-200"
				>
					Securing high-yield returns through the acquisition of
					world-class equestrian talent.
				</p>
				<div
					class="pt-10 flex flex-col sm:flex-row items-center justify-center gap-4 reveal reveal-up delay-300"
				>
					<a
						href="#portfolio"
						class="bg-accent text-white px-6 py-3 text-sm font-bold uppercase tracking-[0.2em] hover:bg-primary hover:text-white hover:scale-105 transition-all shadow-xl"
					>
						View Portfolio
					</a>
					<a
						href="#roi"
						class="bg-accent text-white px-6 py-3 text-sm font-bold uppercase tracking-[0.2em] hover:bg-primary hover:text-white hover:scale-105 transition-all shadow-xl"
					>
						{t("nav.roi")}
					</a>
				</div>
			</div>

			<div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center justify-center opacity-70">
				<span class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/70 mb-3 block">Scroll</span>
				<div class="w-[2px] h-12 bg-white/20 relative overflow-hidden rounded-full">
					<div class="w-full h-1/2 bg-white/80 absolute top-0 left-0 animate-scroll-line rounded-full"></div>
				</div>
			</div>
		</section>

		<div class="reveal reveal-up">
			<About />
		</div>

		<section id="portfolio" class="bg-bg-subtle">
			<PortfolioGallery />
		</section>

		<div class="reveal reveal-up">
			<References />
		</div>

		<div class="reveal reveal-up">
			<Partners />
		</div>

		<div class="reveal reveal-up">
			<Reviews />
		</div>

		<section
			id="roi"
			class="pt-0 pb-12 md:pb-16 bg-white reveal reveal-up border-t-0 scroll-mt-24 md:scroll-mt-24"
		>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<RoiCalculatorTabs lang={lang} client:load />
			</div>
		</section>

		<div class="reveal reveal-up">
			<VideoShowcase />
		</div>

		<div class="reveal reveal-up">
			<News lang={lang} />
		</div>

		<div class="reveal reveal-up">
			<Faq lang={lang} />
		</div>

		<div class="reveal reveal-up">
			<Contact />
		</div>
	</div>
</Layout>
