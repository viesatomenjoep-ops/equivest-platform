---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import About from '../../components/About.astro';
import VideoShowcase from '../../components/VideoShowcase.astro';
import PrimeSelection from '../../components/PrimeSelection.astro';
import References from '../../components/References.astro';
import Partners from '../../components/Partners.astro';
import Reviews from '../../components/Reviews.astro';
import RoiCalculator from '../../components/RoiCalculator.jsx';
import News from '../../components/News.astro';
import Contact from '../../components/Contact.astro';
import Faq from '../../components/Faq.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { Image } from 'astro:assets';
import heroImg from '../../assets/images/hero.png';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'de' } },
    { params: { lang: 'es' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('hero.title')} lang={lang}>
	<Header />
	
	<main>
		<!-- Hero Section -->
		<section class="relative h-[90vh] flex items-center justify-center overflow-hidden premium-gradient text-white">
			<div class="absolute inset-0 opacity-70">
				<Image 
					src={heroImg} 
					alt="Elite Jumper"
					loading="eager"
					class="w-full h-full object-cover object-top"
				/>
				<div class="absolute inset-0 bg-gradient-to-b from-primary/60 via-primary/20 to-primary/90"></div>
			</div>
			
			<div class="relative z-10 max-w-5xl mx-auto px-4 text-center space-y-8">
				<div class="inline-flex items-center space-x-2 px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full mb-4">
					<span class="w-2 h-2 bg-accent-light rounded-full animate-pulse"></span>
					<span class="text-[15px] font-bold uppercase tracking-[0.2em] text-white">{t('hero.subtitle')}</span>
				</div>
				<h1 class="text-5xl md:text-8xl font-serif text-white leading-[1.1] tracking-tight reveal reveal-up delay-100">
					{t('hero.title').split(' ').map((word, i) => (
						i === 2 ? <span class="text-accent-light italic">{word} </span> : word + ' '
					))}
				</h1>
				<p class="text-xl md:text-2xl font-light text-white/80 max-w-2xl mx-auto leading-relaxed reveal reveal-up delay-200">
					Securing high-yield returns through the acquisition of world-class equestrian talent.
				</p>
				<div class="pt-10 flex flex-col sm:flex-row items-center justify-center gap-6 reveal reveal-up delay-300">
					<a href={`/${lang}/portfolio`} class="bg-accent text-white px-10 py-5 text-sm font-bold uppercase tracking-[0.2em] hover:bg-primary-light hover:text-white hover:scale-105 transition-all shadow-2xl">
						View Portfolio
					</a>
					<a href="#roi" class="px-10 py-5 text-sm font-bold uppercase tracking-[0.2em] text-white border border-white/30 hover:bg-white/10 transition-all">
						{t('nav.roi')}
					</a>
				</div>
			</div>
			
			<div class="absolute bottom-12 left-1/2 -translate-x-1/2 animate-bounce opacity-40">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
				</svg>
			</div>
		</section>

		<div class="reveal reveal-up">
			<About />
		</div>
		
		<section id="roi" class="py-24 bg-white reveal reveal-up">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<RoiCalculator lang={lang} client:load />
			</div>
		</section>

		<div class="reveal reveal-up">
			<VideoShowcase />
		</div>

		<div class="reveal reveal-up">
			<News lang={lang} />
		</div>

		<div class="reveal reveal-up">
			<PrimeSelection />
		</div>
		
		<div class="reveal reveal-up">
			<References />
		</div>
		
		<div class="reveal reveal-up">
			<Partners />
		</div>

		<div class="reveal reveal-up">
			<Reviews />
		</div>

		<div class="reveal reveal-up">
			<Faq lang={lang} />
		</div>

		<div class="reveal reveal-up">
			<Contact />
		</div>
	</main>
</Layout>
