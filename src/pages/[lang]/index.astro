---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import About from '../../components/About.astro';
import PortfolioGallery from '../../components/PortfolioGallery.astro';
import RoiCalculator from '../../components/RoiCalculator.jsx';
import Contact from '../../components/Contact.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'de' } },
    { params: { lang: 'es' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('hero.title')} lang={lang}>
	<Header />
	
	<main>
		<!-- Hero Section -->
		<section class="relative h-[100vh] flex items-center justify-center overflow-hidden premium-gradient text-white">
			<div class="absolute inset-0">
				<img 
					src="https://images.unsplash.com/photo-1598974357801-cbca100e65d3?q=80&w=2070&auto=format&fit=crop" 
					alt="Elite Jumper" 
					class="w-full h-full object-cover opacity-30"
				/>
				<div class="absolute inset-0 bg-gradient-to-b from-primary/60 via-primary/40 to-primary"></div>
			</div>
			
			<div class="relative z-10 max-w-5xl mx-auto px-4 text-center space-y-8">
				<div class="inline-flex items-center space-x-2 px-5 py-2.5 bg-white/10 backdrop-blur-sm border border-white/10 rounded-full reveal reveal-up">
					<span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
					<span class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/80">{t('hero.subtitle')}</span>
				</div>
				<h1 class="text-5xl md:text-7xl lg:text-8xl font-serif leading-[1.05] tracking-tight reveal reveal-up delay-100">
					{t('hero.title').split(' ').map((word, i) => (
						i === 2 ? <span class="text-accent italic">{word} </span> : word + ' '
					))}
				</h1>
				<p class="text-lg md:text-xl font-light text-white/60 max-w-2xl mx-auto leading-relaxed reveal reveal-up delay-200">
					Securing high-yield returns through the acquisition of world-class equestrian talent.
				</p>
				<div class="pt-8 flex flex-col sm:flex-row items-center justify-center gap-4 reveal reveal-up delay-300">
					<a href="#portfolio" class="bg-accent text-primary px-10 py-4 text-[11px] font-bold uppercase tracking-[0.2em] hover:bg-white hover:scale-105 transition-all shadow-2xl rounded-xl">
						View Portfolio
					</a>
					<a href="#roi" class="px-10 py-4 text-[11px] font-bold uppercase tracking-[0.2em] border border-white/20 hover:bg-white/10 transition-all rounded-xl text-white/80">
						{t('nav.roi')}
					</a>
				</div>
			</div>
			
			<div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-30">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
				</svg>
			</div>
		</section>

		<div class="reveal reveal-up">
			<About />
		</div>
		
		<section id="roi" class="py-24 md:py-32 bg-white reveal reveal-up">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<RoiCalculator lang={lang} client:load />
			</div>
		</section>

		<div class="reveal reveal-up">
			<PortfolioGallery />
		</div>
		<div class="reveal reveal-up">
			<Contact />
		</div>
	</main>
</Layout>
